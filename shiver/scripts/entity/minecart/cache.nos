# Shiver script | REPIS
# Построение кэша геометрии одного сегмента маршрута.
# Аргументы: 0 - UUID вагонетки; 1 - индекс сегмента; 2 - 0 активный / 1 предварительный кэш.

set 'buildIndex' arg.1
copyToLocal 'MINECART.var(arg.0).route' 'route'
setVars [
    'i0'; max(var(buildIndex) - 1, 0);
    'i1'; var(buildIndex);
    'i2'; var(buildIndex) + 1;
    'i3'; min(var(buildIndex) + 2, global(MINECART.var(arg.0).routeLastIndex))
]
list.get 'route' var(i0); 'p0'
list.get 'route' var(i1); 'p1'
list.get 'route' var(i2); 'p2'
list.get 'route' var(i3); 'p3'
list.unpack 'p0' ['p0x'; 'p0y'; 'p0z']
list.unpack 'p1' ['p1x'; 'p1y'; 'p1z']
list.unpack 'p2' ['p2x'; 'p2y'; 'p2z']
list.unpack 'p3' ['p3x'; 'p3y'; 'p3z']

if var(buildIndex) != 0 { jump 'buildP0Done' }
setVars [
    'p0x'; 2 * var(p1x) - var(p2x);
    'p0y'; 2 * var(p1y) - var(p2y);
    'p0z'; 2 * var(p1z) - var(p2z)
]
@buildP0Done

if var(buildIndex) < global(MINECART.var(arg.0).routeLastIndex) - 1 { jump 'buildP3Done' }
setVars [
    'p3x'; 2 * var(p2x) - var(p1x);
    'p3y'; 2 * var(p2y) - var(p1y);
    'p3z'; 2 * var(p2z) - var(p1z)
]
@buildP3Done

setVars [
    'h01'; sqrt((var(p1x) - var(p0x)) * (var(p1x) - var(p0x)) + (var(p1z) - var(p0z)) * (var(p1z) - var(p0z)));
    'h12'; sqrt((var(p2x) - var(p1x)) * (var(p2x) - var(p1x)) + (var(p2z) - var(p1z)) * (var(p2z) - var(p1z)));
    'h23'; sqrt((var(p3x) - var(p2x)) * (var(p3x) - var(p2x)) + (var(p3z) - var(p2z)) * (var(p3z) - var(p2z)));
    'p1BaseX'; var(p1x);
    'p1BaseZ'; var(p1z);
    'p2BaseX'; var(p2x);
    'p2BaseZ'; var(p2z);
    'rampPrev'; 0;
    'rampCurrent'; 0;
    'rampNext'; 0
]

# A block-centre ramp has one extra horizontal block between its centres
# compared with the rail line: move each endpoint inward by half a block.
if var(buildIndex) <= 0 { jump 'checkCurrentRamp' }
if var(p1y) == var(p0y) { jump 'checkCurrentRamp' }
if abs(var(h01) - abs(var(p1y) - var(p0y)) - 1) > 0.15 { jump 'checkCurrentRamp' }
set 'rampPrev' 1

@checkCurrentRamp
if var(p2y) == var(p1y) { jump 'checkNextRamp' }
if abs(var(h12) - abs(var(p2y) - var(p1y)) - 1) > 0.15 { jump 'checkNextRamp' }
set 'rampCurrent' 1

@checkNextRamp
if var(buildIndex) >= global(MINECART.var(arg.0).routeLastIndex) - 1 { jump 'adjustRampPoints' }
if var(p3y) == var(p2y) { jump 'adjustRampPoints' }
if abs(var(h23) - abs(var(p3y) - var(p2y)) - 1) > 0.15 { jump 'adjustRampPoints' }
set 'rampNext' 1

@adjustRampPoints
# The start point is shared with the previous segment. Prefer the current ramp
# when two ramps meet; otherwise reuse the previous ramp's adjusted endpoint.
if var(rampCurrent) > 0 { jump 'shiftP1TowardP2' }
if var(rampPrev) <= 0 { jump 'shiftP1Done' }
if var(h01) <= 0.001 { jump 'shiftP1Done' }
set 'p1x' var(p1BaseX) + 0.5 * (var(p0x) - var(p1BaseX)) / var(h01)
set 'p1z' var(p1BaseZ) + 0.5 * (var(p0z) - var(p1BaseZ)) / var(h01)
jump 'shiftP1Done'

@shiftP1TowardP2
if var(h12) <= 0.001 { jump 'shiftP1Done' }
set 'p1x' var(p1BaseX) + 0.5 * (var(p2BaseX) - var(p1BaseX)) / var(h12)
set 'p1z' var(p1BaseZ) + 0.5 * (var(p2BaseZ) - var(p1BaseZ)) / var(h12)
@shiftP1Done

# The end point is shared with the following segment.
if var(rampNext) > 0 { jump 'shiftP2TowardP3' }
if var(rampCurrent) <= 0 { jump 'shiftP2Done' }
if var(h12) <= 0.001 { jump 'shiftP2Done' }
set 'p2x' var(p2BaseX) + 0.5 * (var(p1BaseX) - var(p2BaseX)) / var(h12)
set 'p2z' var(p2BaseZ) + 0.5 * (var(p1BaseZ) - var(p2BaseZ)) / var(h12)
jump 'shiftP2Done'

@shiftP2TowardP3
if var(h23) <= 0.001 { jump 'shiftP2Done' }
set 'p2x' var(p2BaseX) + 0.5 * (var(p3x) - var(p2BaseX)) / var(h23)
set 'p2z' var(p2BaseZ) + 0.5 * (var(p3z) - var(p2BaseZ)) / var(h23)
@shiftP2Done

# Cache corrected adjacent control points for axle samples across segment boundaries.
setVars [
    'prevRailLength'; sqrt((var(p1x) - var(p0x)) * (var(p1x) - var(p0x)) + (var(p1y) - var(p0y)) * (var(p1y) - var(p0y)) + (var(p1z) - var(p0z)) * (var(p1z) - var(p0z)));
    'nextRailLength'; sqrt((var(p3x) - var(p2x)) * (var(p3x) - var(p2x)) + (var(p3y) - var(p2y)) * (var(p3y) - var(p2y)) + (var(p3z) - var(p2z)) * (var(p3z) - var(p2z)))
]

setVars [
    't01'; max(sqrt(sqrt((var(p1x) - var(p0x)) * (var(p1x) - var(p0x)) + (var(p1y) - var(p0y)) * (var(p1y) - var(p0y)) + (var(p1z) - var(p0z)) * (var(p1z) - var(p0z)))), 0.001);
    't12'; max(sqrt(sqrt((var(p2x) - var(p1x)) * (var(p2x) - var(p1x)) + (var(p2y) - var(p1y)) * (var(p2y) - var(p1y)) + (var(p2z) - var(p1z)) * (var(p2z) - var(p1z)))), 0.001);
    't23'; max(sqrt(sqrt((var(p3x) - var(p2x)) * (var(p3x) - var(p2x)) + (var(p3y) - var(p2y)) * (var(p3y) - var(p2y)) + (var(p3z) - var(p2z)) * (var(p3z) - var(p2z)))), 0.001)
]
# Monotone X/Z tangents prevent lateral overshoot at sharp route turns.
setVars [
    'w1'; 2 * var(t12) + var(t01);
    'w2'; var(t12) + 2 * var(t01);
    'w3'; 2 * var(t23) + var(t12);
    'w4'; var(t23) + 2 * var(t12);
    's0x'; (var(p1x) - var(p0x)) / var(t01);
    's1x'; (var(p2x) - var(p1x)) / var(t12);
    's2x'; (var(p3x) - var(p2x)) / var(t23);
    's0z'; (var(p1z) - var(p0z)) / var(t01);
    's1z'; (var(p2z) - var(p1z)) / var(t12);
    's2z'; (var(p3z) - var(p2z)) / var(t23);
    'm1x'; 0;
    'm2x'; 0;
    'm1z'; 0;
    'm2z'; 0
]
if var(s0x) * var(s1x) <= 0 { jump 'buildM1XDone' }
set 'm1x' var(t12) * (var(w1) + var(w2)) / (var(w1) / var(s0x) + var(w2) / var(s1x))
@buildM1XDone
if var(s1x) * var(s2x) <= 0 { jump 'buildM2XDone' }
set 'm2x' var(t12) * (var(w3) + var(w4)) / (var(w3) / var(s1x) + var(w4) / var(s2x))
@buildM2XDone
if var(s0z) * var(s1z) <= 0 { jump 'buildM1ZDone' }
set 'm1z' var(t12) * (var(w1) + var(w2)) / (var(w1) / var(s0z) + var(w2) / var(s1z))
@buildM1ZDone
if var(s1z) * var(s2z) <= 0 { jump 'buildM2ZDone' }
set 'm2z' var(t12) * (var(w3) + var(w4)) / (var(w3) / var(s1z) + var(w4) / var(s2z))
@buildM2ZDone

setVars [
    's0y'; (var(p1y) - var(p0y)) / var(t01);
    's1y'; (var(p2y) - var(p1y)) / var(t12);
    's2y'; (var(p3y) - var(p2y)) / var(t23);
    'm1y'; 0;
    'm2y'; 0
]

# On a flat-to-slope transition, follow the segment slope immediately.
# This moves the anchor clear of the upper block's lower corner.
if var(s0y) == 0 { jump 'buildM1YFlat' }
if var(s0y) * var(s1y) <= 0 { jump 'buildM1YDone' }
set 'm1y' var(t12) * (var(w1) + var(w2)) / (var(w1) / var(s0y) + var(w2) / var(s1y))
jump 'buildM1YDone'
@buildM1YFlat
if var(s1y) == 0 { jump 'buildM1YDone' }
# Match X/Y/Z tangent components to the same sloped rail segment.
setVars [
    'm1x'; var(p2x) - var(p1x);
    'm1y'; var(t12) * var(s1y);
    'm1z'; var(p2z) - var(p1z)
]
@buildM1YDone

if var(s2y) == 0 { jump 'buildM2YFlat' }
if var(s1y) * var(s2y) <= 0 { jump 'buildM2YDone' }
set 'm2y' var(t12) * (var(w3) + var(w4)) / (var(w3) / var(s1y) + var(w4) / var(s2y))
jump 'buildM2YDone'
@buildM2YFlat
if var(s1y) == 0 { jump 'buildM2YDone' }
# Keep the tangent aligned with the incoming sloped rail segment.
setVars [
    'm2x'; var(p2x) - var(p1x);
    'm2y'; var(t12) * var(s1y);
    'm2z'; var(p2z) - var(p1z)
]
@buildM2YDone

setVars [
    'aX'; 2 * var(p1x) - 2 * var(p2x) + var(m1x) + var(m2x);
    'bX'; (0 - 3 * var(p1x)) + 3 * var(p2x) - 2 * var(m1x) - var(m2x);
    'cX'; var(m1x);
    'dX'; var(p1x);
    'aY'; 2 * var(p1y) - 2 * var(p2y) + var(m1y) + var(m2y);
    'bY'; (0 - 3 * var(p1y)) + 3 * var(p2y) - 2 * var(m1y) - var(m2y);
    'cY'; var(m1y);
    'dY'; var(p1y);
    'aZ'; 2 * var(p1z) - 2 * var(p2z) + var(m1z) + var(m2z);
    'bZ'; (0 - 3 * var(p1z)) + 3 * var(p2z) - 2 * var(m1z) - var(m2z);
    'cZ'; var(m1z);
    'dZ'; var(p1z)
]

# Rail segments with a vertical change are straight ramps: keep position and
# tangent exactly on the line between the two route points.
if var(s1y) == 0 { jump 'buildSplineDone' }
setVars [
    'aX'; 0;
    'bX'; 0;
    'cX'; var(p2x) - var(p1x);
    'dX'; var(p1x);
    'aY'; 0;
    'bY'; 0;
    'cY'; var(p2y) - var(p1y);
    'dY'; var(p1y);
    'aZ'; 0;
    'bZ'; 0;
    'cZ'; var(p2z) - var(p1z);
    'dZ'; var(p1z)
]
@buildSplineDone

setGlobals [
    'MINECART.var(arg.0).aX'; var(aX);
    'MINECART.var(arg.0).bX'; var(bX);
    'MINECART.var(arg.0).cX'; var(cX);
    'MINECART.var(arg.0).dX'; var(dX);
    'MINECART.var(arg.0).aY'; var(aY);
    'MINECART.var(arg.0).bY'; var(bY);
    'MINECART.var(arg.0).cY'; var(cY);
    'MINECART.var(arg.0).dY'; var(dY);
    'MINECART.var(arg.0).aZ'; var(aZ);
    'MINECART.var(arg.0).bZ'; var(bZ);
    'MINECART.var(arg.0).cZ'; var(cZ);
    'MINECART.var(arg.0).dZ'; var(dZ);
    'MINECART.var(arg.0).p0x'; var(p0x);
    'MINECART.var(arg.0).p0y'; var(p0y);
    'MINECART.var(arg.0).p0z'; var(p0z);
    'MINECART.var(arg.0).p1x'; var(p1x);
    'MINECART.var(arg.0).p1y'; var(p1y);
    'MINECART.var(arg.0).p1z'; var(p1z);
    'MINECART.var(arg.0).p2x'; var(p2x);
    'MINECART.var(arg.0).p2y'; var(p2y);
    'MINECART.var(arg.0).p2z'; var(p2z);
    'MINECART.var(arg.0).p3x'; var(p3x);
    'MINECART.var(arg.0).p3y'; var(p3y);
    'MINECART.var(arg.0).p3z'; var(p3z);
    'MINECART.var(arg.0).prevRailLength'; var(prevRailLength);
    'MINECART.var(arg.0).nextRailLength'; var(nextRailLength);
    'MINECART.var(arg.0).cacheIndex'; var(buildIndex)
]
if arg.2 <= 0 { jump 'saveActive' }
if global(MINECART.var(arg.0).cacheRequestedIndex) != var(buildIndex) { jump 'done' }
setGlobals [
    'MINECART.var(arg.0).pendingAX'; var(aX);
    'MINECART.var(arg.0).pendingBX'; var(bX);
    'MINECART.var(arg.0).pendingCX'; var(cX);
    'MINECART.var(arg.0).pendingDX'; var(dX);
    'MINECART.var(arg.0).pendingAY'; var(aY);
    'MINECART.var(arg.0).pendingBY'; var(bY);
    'MINECART.var(arg.0).pendingCY'; var(cY);
    'MINECART.var(arg.0).pendingDY'; var(dY);
    'MINECART.var(arg.0).pendingAZ'; var(aZ);
    'MINECART.var(arg.0).pendingBZ'; var(bZ);
    'MINECART.var(arg.0).pendingCZ'; var(cZ);
    'MINECART.var(arg.0).pendingDZ'; var(dZ);
    'MINECART.var(arg.0).pendingP0x'; var(p0x);
    'MINECART.var(arg.0).pendingP0y'; var(p0y);
    'MINECART.var(arg.0).pendingP0z'; var(p0z);
    'MINECART.var(arg.0).pendingP1x'; var(p1x);
    'MINECART.var(arg.0).pendingP1y'; var(p1y);
    'MINECART.var(arg.0).pendingP1z'; var(p1z);
    'MINECART.var(arg.0).pendingP2x'; var(p2x);
    'MINECART.var(arg.0).pendingP2y'; var(p2y);
    'MINECART.var(arg.0).pendingP2z'; var(p2z);
    'MINECART.var(arg.0).pendingP3x'; var(p3x);
    'MINECART.var(arg.0).pendingP3y'; var(p3y);
    'MINECART.var(arg.0).pendingP3z'; var(p3z);
    'MINECART.var(arg.0).pendingPrevRailLength'; var(prevRailLength);
    'MINECART.var(arg.0).pendingNextRailLength'; var(nextRailLength)
]
setGlobal 'MINECART.var(arg.0).cachePendingIndex' var(buildIndex)
jump 'done'

@saveActive
setGlobals [
    'MINECART.var(arg.0).aX'; var(aX);
    'MINECART.var(arg.0).bX'; var(bX);
    'MINECART.var(arg.0).cX'; var(cX);
    'MINECART.var(arg.0).dX'; var(dX);
    'MINECART.var(arg.0).aY'; var(aY);
    'MINECART.var(arg.0).bY'; var(bY);
    'MINECART.var(arg.0).cY'; var(cY);
    'MINECART.var(arg.0).dY'; var(dY);
    'MINECART.var(arg.0).aZ'; var(aZ);
    'MINECART.var(arg.0).bZ'; var(bZ);
    'MINECART.var(arg.0).cZ'; var(cZ);
    'MINECART.var(arg.0).dZ'; var(dZ);
    'MINECART.var(arg.0).p0x'; var(p0x);
    'MINECART.var(arg.0).p0y'; var(p0y);
    'MINECART.var(arg.0).p0z'; var(p0z);
    'MINECART.var(arg.0).p1x'; var(p1x);
    'MINECART.var(arg.0).p1y'; var(p1y);
    'MINECART.var(arg.0).p1z'; var(p1z);
    'MINECART.var(arg.0).p2x'; var(p2x);
    'MINECART.var(arg.0).p2y'; var(p2y);
    'MINECART.var(arg.0).p2z'; var(p2z);
    'MINECART.var(arg.0).p3x'; var(p3x);
    'MINECART.var(arg.0).p3y'; var(p3y);
    'MINECART.var(arg.0).p3z'; var(p3z);
    'MINECART.var(arg.0).prevRailLength'; var(prevRailLength);
    'MINECART.var(arg.0).nextRailLength'; var(nextRailLength)
]
setGlobal 'MINECART.var(arg.0).cacheIndex' var(buildIndex)
@done
pass