# Shiver script | REPIS
# Экспериментальная плоская версия движения сюжетной вагонетки.
# Аргументы: 0 - uuid вагонетки; 1 - выполнить движение.
# Все рабочие метки находятся на одном уровне; buildCache возвращается через back.

@entry
if var(arg.1) * global(MINECART.var(arg.0).canMove) <= 0 { jump 'trigger' }
if global(MINECART.var(arg.0).routeLastIndex) <= 0 { jump 'legacyMove' }

if global(MINECART.var(arg.0).routeIndex) >= global(MINECART.var(arg.0).routeLastIndex) {
    setGlobal 'MINECART.var(arg.0).canMove' 0
    jump 'trigger'
}

if global(MINECART.var(arg.0).cacheIndex) == global(MINECART.var(arg.0).routeIndex) { jump 'loadCoefficients' }
set 'back' 'loadCoefficients'
jump 'buildCache'

@loadCoefficients

set 'u2' global(MINECART.var(arg.0).routeProgress) * global(MINECART.var(arg.0).routeProgress)
setVars [
    'tangentX'; 3 * global(MINECART.var(arg.0).aX) * var(u2) + 2 * global(MINECART.var(arg.0).bX) * global(MINECART.var(arg.0).routeProgress) + global(MINECART.var(arg.0).cX);
    'tangentY'; 3 * global(MINECART.var(arg.0).aY) * var(u2) + 2 * global(MINECART.var(arg.0).bY) * global(MINECART.var(arg.0).routeProgress) + global(MINECART.var(arg.0).cY);
    'tangentZ'; 3 * global(MINECART.var(arg.0).aZ) * var(u2) + 2 * global(MINECART.var(arg.0).bZ) * global(MINECART.var(arg.0).routeProgress) + global(MINECART.var(arg.0).cZ)
]
set 'tangentLength' sqrt(var(tangentX) * var(tangentX) + var(tangentY) * var(tangentY) + var(tangentZ) * var(tangentZ))
if var(tangentLength) <= 0.001 {
    setGlobal 'MINECART.var(arg.0).canMove' 0
    jump 'trigger'
}

set 'nextProgress' min(1, global(MINECART.var(arg.0).routeProgress) + global(MINECART.var(arg.0).speed) / var(tangentLength))
setVars [
    'nextU2'; var(nextProgress) * var(nextProgress);
    'nextU3'; var(nextProgress) * var(nextProgress) * var(nextProgress)
]
setVars [
    'nextTX'; 3 * global(MINECART.var(arg.0).aX) * var(nextU2) + 2 * global(MINECART.var(arg.0).bX) * var(nextProgress) + global(MINECART.var(arg.0).cX);
    'nextTY'; 3 * global(MINECART.var(arg.0).aY) * var(nextU2) + 2 * global(MINECART.var(arg.0).bY) * var(nextProgress) + global(MINECART.var(arg.0).cY);
    'nextTZ'; 3 * global(MINECART.var(arg.0).aZ) * var(nextU2) + 2 * global(MINECART.var(arg.0).bZ) * var(nextProgress) + global(MINECART.var(arg.0).cZ)
]
set 'horizontal' sqrt(var(nextTX) * var(nextTX) + var(nextTZ) * var(nextTZ))

set 'nextPitch' atan2(0 - var(nextTY), var(horizontal)) * 57.29577951308232
if var(horizontal) <= 0.001 { jump 'keepYaw' }
set 'nextYaw' global(MINECART.var(arg.0).lastYaw) + wrap(atan2(0 - var(nextTX), var(nextTZ)) * 57.29577951308232 - global(MINECART.var(arg.0).lastYaw), -180, 180)
Entity.tp 'var(arg.0)'
    global(MINECART.var(arg.0).aX) * var(nextU3) + global(MINECART.var(arg.0).bX) * var(nextU2) + global(MINECART.var(arg.0).cX) * var(nextProgress) + global(MINECART.var(arg.0).dX);
    global(MINECART.var(arg.0).aY) * var(nextU3) + global(MINECART.var(arg.0).bY) * var(nextU2) + global(MINECART.var(arg.0).cY) * var(nextProgress) + global(MINECART.var(arg.0).dY);
    global(MINECART.var(arg.0).aZ) * var(nextU3) + global(MINECART.var(arg.0).bZ) * var(nextU2) + global(MINECART.var(arg.0).cZ) * var(nextProgress) + global(MINECART.var(arg.0).dZ);
    var(nextYaw); var(nextPitch);
copyToGlobal 'nextYaw' 'MINECART.var(arg.0).lastYaw'
jump 'afterYaw'

@keepYaw
Entity.tp 'var(arg.0)'
    global(MINECART.var(arg.0).aX) * var(nextU3) + global(MINECART.var(arg.0).bX) * var(nextU2) + global(MINECART.var(arg.0).cX) * var(nextProgress) + global(MINECART.var(arg.0).dX);
    global(MINECART.var(arg.0).aY) * var(nextU3) + global(MINECART.var(arg.0).bY) * var(nextU2) + global(MINECART.var(arg.0).cY) * var(nextProgress) + global(MINECART.var(arg.0).dY);
    global(MINECART.var(arg.0).aZ) * var(nextU3) + global(MINECART.var(arg.0).bZ) * var(nextU2) + global(MINECART.var(arg.0).cZ) * var(nextProgress) + global(MINECART.var(arg.0).dZ);
    global(MINECART.var(arg.0).lastYaw); var(nextPitch);
@afterYaw

if var(nextProgress) < 1 { jump 'saveProgress' }
setGlobal 'MINECART.var(arg.0).routeIndex' global(MINECART.var(arg.0).routeIndex) + 1
setGlobal 'MINECART.var(arg.0).routeProgress' 0
if global(MINECART.var(arg.0).routeIndex) >= global(MINECART.var(arg.0).routeLastIndex) { setGlobal 'MINECART.var(arg.0).canMove' 0 }
jump 'trigger'

@saveProgress
copyToGlobal 'nextProgress' 'MINECART.var(arg.0).routeProgress'
jump 'trigger'

@legacyMove
copyToLocal 'MINECART.var(arg.0).direction' 'direction'
list.unpack 'direction' ['x'; 'y'; 'z']
Entity.getPos 'var(arg.0)' 'pos'
Entity.tp 'var(arg.0)'
    var(pos.x) + var(x) * global(MINECART.var(arg.0).speed);
    var(pos.y) + var(y) * global(MINECART.var(arg.0).speed);
    var(pos.z) + var(z) * global(MINECART.var(arg.0).speed);
    var(pos.yaw); var(pos.pitch);
jump 'trigger'

@buildCache
copyToLocal 'MINECART.var(arg.0).route' 'route'
setVars [
    'i0'; max(global(MINECART.var(arg.0).routeIndex) - 1, 0);
    'i1'; global(MINECART.var(arg.0).routeIndex);
    'i2'; global(MINECART.var(arg.0).routeIndex) + 1;
    'i3'; min(global(MINECART.var(arg.0).routeIndex) + 2, global(MINECART.var(arg.0).routeLastIndex))
]
list.get 'route' var(i0); 'p0'
list.get 'route' var(i1); 'p1'
list.get 'route' var(i2); 'p2'
list.get 'route' var(i3); 'p3'
list.unpack 'p0' ['p0x'; 'p0y'; 'p0z']
list.unpack 'p1' ['p1x'; 'p1y'; 'p1z']
list.unpack 'p2' ['p2x'; 'p2y'; 'p2z']
list.unpack 'p3' ['p3x'; 'p3y'; 'p3z']

if global(MINECART.var(arg.0).routeIndex) != 0 { jump 'buildP0Done' }
setVars [
    'p0x'; 2 * var(p1x) - var(p2x);
    'p0y'; 2 * var(p1y) - var(p2y);
    'p0z'; 2 * var(p1z) - var(p2z)
]
@buildP0Done

if global(MINECART.var(arg.0).routeIndex) < global(MINECART.var(arg.0).routeLastIndex) - 1 { jump 'buildP3Done' }
setVars [
    'p3x'; 2 * var(p2x) - var(p1x);
    'p3y'; 2 * var(p2y) - var(p1y);
    'p3z'; 2 * var(p2z) - var(p1z)
]
@buildP3Done

setVars [
    't01'; max(sqrt(sqrt((var(p1x) - var(p0x)) * (var(p1x) - var(p0x)) + (var(p1y) - var(p0y)) * (var(p1y) - var(p0y)) + (var(p1z) - var(p0z)) * (var(p1z) - var(p0z)))), 0.001);
    't12'; max(sqrt(sqrt((var(p2x) - var(p1x)) * (var(p2x) - var(p1x)) + (var(p2y) - var(p1y)) * (var(p2y) - var(p1y)) + (var(p2z) - var(p1z)) * (var(p2z) - var(p1z)))), 0.001);
    't23'; max(sqrt(sqrt((var(p3x) - var(p2x)) * (var(p3x) - var(p2x)) + (var(p3y) - var(p2y)) * (var(p3y) - var(p2y)) + (var(p3z) - var(p2z)) * (var(p3z) - var(p2z)))), 0.001)
]
setVars [
    'r10'; var(t12) / var(t01);
    'r20'; var(t12) / (var(t01) + var(t12));
    'r31'; var(t12) / (var(t12) + var(t23));
    'r32'; var(t12) / var(t23)
]

setVars [
    'm1x'; (var(p1x) - var(p0x)) * var(r10) - (var(p2x) - var(p0x)) * var(r20) + (var(p2x) - var(p1x));
    'm1z'; (var(p1z) - var(p0z)) * var(r10) - (var(p2z) - var(p0z)) * var(r20) + (var(p2z) - var(p1z));
    'm2x'; (var(p2x) - var(p1x)) - (var(p3x) - var(p1x)) * var(r31) + (var(p3x) - var(p2x)) * var(r32);
    'm2z'; (var(p2z) - var(p1z)) - (var(p3z) - var(p1z)) * var(r31) + (var(p3z) - var(p2z)) * var(r32)
]

setVars [
    's0y'; (var(p1y) - var(p0y)) / var(t01);
    's1y'; (var(p2y) - var(p1y)) / var(t12);
    's2y'; (var(p3y) - var(p2y)) / var(t23);
    'w1'; 2 * var(t12) + var(t01);
    'w2'; var(t12) + 2 * var(t01);
    'w3'; 2 * var(t23) + var(t12);
    'w4'; var(t23) + 2 * var(t12);
    'm1y'; 0;
    'm2y'; 0
]
if var(s0y) * var(s1y) <= 0 { jump 'buildM1Done' }
set 'm1y' var(t12) * (var(w1) + var(w2)) / (var(w1) / var(s0y) + var(w2) / var(s1y))
@buildM1Done
if var(s1y) * var(s2y) <= 0 { jump 'buildM2Done' }
set 'm2y' var(t12) * (var(w3) + var(w4)) / (var(w3) / var(s1y) + var(w4) / var(s2y))
@buildM2Done

setVars [
    'aX'; 2 * var(p1x) - 2 * var(p2x) + var(m1x) + var(m2x);
    'bX'; (0 - 3 * var(p1x)) + 3 * var(p2x) - 2 * var(m1x) - var(m2x);
    'cX'; var(m1x);
    'dX'; var(p1x);
    'aY'; 2 * var(p1y) - 2 * var(p2y) + var(m1y) + var(m2y);
    'bY'; (0 - 3 * var(p1y)) + 3 * var(p2y) - 2 * var(m1y) - var(m2y);
    'cY'; var(m1y);
    'dY'; var(p1y);
    'aZ'; 2 * var(p1z) - 2 * var(p2z) + var(m1z) + var(m2z);
    'bZ'; (0 - 3 * var(p1z)) + 3 * var(p2z) - 2 * var(m1z) - var(m2z);
    'cZ'; var(m1z);
    'dZ'; var(p1z)
]

copyToGlobal 'aX' 'MINECART.var(arg.0).aX'
copyToGlobal 'bX' 'MINECART.var(arg.0).bX'
copyToGlobal 'cX' 'MINECART.var(arg.0).cX'
copyToGlobal 'dX' 'MINECART.var(arg.0).dX'
copyToGlobal 'aY' 'MINECART.var(arg.0).aY'
copyToGlobal 'bY' 'MINECART.var(arg.0).bY'
copyToGlobal 'cY' 'MINECART.var(arg.0).cY'
copyToGlobal 'dY' 'MINECART.var(arg.0).dY'
copyToGlobal 'aZ' 'MINECART.var(arg.0).aZ'
copyToGlobal 'bZ' 'MINECART.var(arg.0).bZ'
copyToGlobal 'cZ' 'MINECART.var(arg.0).cZ'
copyToGlobal 'dZ' 'MINECART.var(arg.0).dZ'
setGlobal 'MINECART.var(arg.0).cacheIndex' global(MINECART.var(arg.0).routeIndex)
jump 'var(back)'

@trigger
wait global(MINECART.var(arg.0).tickDelta) - 1
Entity.getPos 'var(arg.0)' 'pos'
set 'radius' global(MINECART.var(arg.0).triggerRadius)
Shiver.spawnTrigger 'minecart.var(arg.0)' 'global(MINECART.var(arg.0).team)' 0;
    (var(pos.x) + var(radius)); (var(pos.y) + var(radius)); (var(pos.z) + var(radius));
    (var(pos.x) - var(radius)); (var(pos.y) - var(radius)); (var(pos.z) - var(radius));
    [*arg.0] {
        run 'entity/minecart/move' '*' [*arg.0; 1]
    }
