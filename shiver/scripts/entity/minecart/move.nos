# Shiver script | REPIS
# Линейное движение сюжетной вагонетки со скруглением поворотов.
# Аргументы: 0 - UUID модели; 1 - выполнить шаг движения.
# Модель следует по маршруту; mount с хитбоксом находится на 0.5 ниже.

@entry
if var(arg.1) * global(MINECART.var(arg.0).canMove) <= 0 { jump 'idle' }
if !global(MINECART.var(arg.0).routeLastIndex) {
    setGlobal 'MINECART.var(arg.0).canMove' 0
    jump 'idle'
}
if global(MINECART.var(arg.0).speed) <= 0 { jump 'idle' }
if global(MINECART.var(arg.0).started) <= 0 { setGlobal 'MINECART.var(arg.0).started' 1; }
setGlobal 'MINECART.var(arg.0).callID' global(MINECART.var(arg.0).callID) + 1
copyToLocal 'MINECART.var(arg.0).route' 'route'
set 'remaining' global(MINECART.var(arg.0).speed)
jump 'routeStep'

@idle
jump 'trigger'

@routeStep
if global(MINECART.var(arg.0).routeIndex) >= global(MINECART.var(arg.0).routeLastIndex) {
    setGlobal 'MINECART.var(arg.0).canMove' 0
    jump 'trigger'
}
list.get 'route' global(MINECART.var(arg.0).routeIndex); 'p1'
list.get 'route' global(MINECART.var(arg.0).routeIndex) + 1; 'p2'
list.unpack 'p1' ['p1x'; 'p1y'; 'p1z']
list.unpack 'p2' ['p2x'; 'p2y'; 'p2z']

setVars [
    'dx'; var(p2x) - var(p1x);
    'dy'; var(p2y) - var(p1y);
    'dz'; var(p2z) - var(p1z);
    'moveType'; 0
]
set 'segmentLength' sqrt(var(dx) * var(dx) + var(dy) * var(dy) + var(dz) * var(dz))
if var(segmentLength) <= 0.001 { jump 'skipSegment' }

# Диагональная связка между прямыми перпендикулярными участками становится дугой 90°.
if global(MINECART.var(arg.0).routeIndex) <= 0 { jump 'lengthReady' }
if global(MINECART.var(arg.0).routeIndex) >= global(MINECART.var(arg.0).routeLastIndex) - 1 { jump 'lengthReady' }
if abs(var(dy)) > 0.001 { jump 'lengthReady' }
if abs(var(dx)) <= 0.001 { jump 'lengthReady' }
if abs(var(dz)) <= 0.001 { jump 'lengthReady' }

list.get 'route' global(MINECART.var(arg.0).routeIndex) - 1; 'p0'
list.get 'route' global(MINECART.var(arg.0).routeIndex) + 2; 'p3'
list.unpack 'p0' ['p0x'; '*'; 'p0z']
list.unpack 'p3' ['p3x'; '*'; 'p3z']
setVars [
    'inX'; var(p1x) - var(p0x);
    'inZ'; var(p1z) - var(p0z);
    'outX'; var(p3x) - var(p2x);
    'outZ'; var(p3z) - var(p2z)
]
setVars [
    'inLength'; sqrt(var(inX) * var(inX) + var(inZ) * var(inZ));
    'outLength'; sqrt(var(outX) * var(outX) + var(outZ) * var(outZ))
]
if var(inLength) <= 0.001 { jump 'lengthReady' }
if var(outLength) <= 0.001 { jump 'lengthReady' }
setVars [
    'dot'; (var(inX) * var(outX) + var(inZ) * var(outZ)) / (var(inLength) * var(outLength));
    'cross'; (var(inX) * var(outZ) - var(inZ) * var(outX)) / (var(inLength) * var(outLength))
]
if abs(var(dot)) > 0.1 { jump 'lengthReady' }
if abs(var(cross)) < 0.9 { jump 'lengthReady' }

setVars [
    'radius'; sqrt(var(dx) * var(dx) + var(dz) * var(dz)) / sqrt(2);
    'turnSide'; 0 - sign(var(cross))
]
setVars [
    'centerX'; var(p1x) + var(inZ) / var(inLength) * var(turnSide) * var(radius);
    'centerZ'; var(p1z) - var(inX) / var(inLength) * var(turnSide) * var(radius)
]
set 'endRadius' sqrt((var(p2x) - var(centerX)) * (var(p2x) - var(centerX)) + (var(p2z) - var(centerZ)) * (var(p2z) - var(centerZ)))
if abs(var(endRadius) - var(radius)) > 0.15 { jump 'lengthReady' }
setVars [
    'startAngle'; atan2(var(p1z) - var(centerZ), var(p1x) - var(centerX)) * 57.29577951308232;
    'endAngle'; atan2(var(p2z) - var(centerZ), var(p2x) - var(centerX)) * 57.29577951308232
]
set 'arcDelta' wrap(var(endAngle) - var(startAngle), -180, 180)
if abs(abs(var(arcDelta)) - 90) > 1 { jump 'lengthReady' }
set 'segmentLength' var(radius) * abs(var(arcDelta)) * 0.017453292519943295
set 'moveType' 1

@lengthReady
set 'distanceLeft' var(segmentLength) - global(MINECART.var(arg.0).routeProgress)
if var(remaining) >= var(distanceLeft) { jump 'crossSegment' }

set 'newProgress' global(MINECART.var(arg.0).routeProgress) + var(remaining)
setGlobal 'MINECART.var(arg.0).routeProgress' var(newProgress)
set 'remaining' 0
set 'u' var(newProgress) / var(segmentLength)
if var(moveType) > 0 { jump 'sampleArc' }

setVars [
    'nextX'; var(p1x) + var(dx) * var(u);
    'nextY'; var(p1y) + var(dy) * var(u);
    'nextZ'; var(p1z) + var(dz) * var(u);
    'moveDirX'; var(dx);
    'moveDirY'; var(dy);
    'moveDirZ'; var(dz)
]
jump 'applyPosition'

@sampleArc
set 'theta' var(startAngle) + var(arcDelta) * var(u)
set 'arcSign' sign(var(arcDelta))
setVars [
    'nextX'; var(centerX) + var(radius) * cos(var(theta));
    'nextY'; var(p1y) + var(dy) * var(u);
    'nextZ'; var(centerZ) + var(radius) * sin(var(theta));
    'moveDirX'; (0 - sin(var(theta))) * var(arcSign);
    'moveDirY'; 0;
    'moveDirZ'; cos(var(theta)) * var(arcSign)
]
jump 'applyPosition'

@crossSegment
set 'remaining' max(var(remaining) - max(var(distanceLeft), 0), 0)
setGlobal 'MINECART.var(arg.0).routeIndex' global(MINECART.var(arg.0).routeIndex) + 1
setGlobal 'MINECART.var(arg.0).routeProgress' 0
if global(MINECART.var(arg.0).routeIndex) >= global(MINECART.var(arg.0).routeLastIndex) { jump 'routeEnd' }
jump 'routeStep'

@skipSegment
setGlobal 'MINECART.var(arg.0).routeIndex' global(MINECART.var(arg.0).routeIndex) + 1
setGlobal 'MINECART.var(arg.0).routeProgress' 0
if global(MINECART.var(arg.0).routeIndex) >= global(MINECART.var(arg.0).routeLastIndex) { jump 'routeEnd' }
jump 'routeStep'

@routeEnd
setGlobal 'MINECART.var(arg.0).canMove' 0
setVars [
    'nextX'; var(p2x);
    'nextY'; var(p2y);
    'nextZ'; var(p2z)
]
if var(moveType) <= 0 { jump 'routeEndLine' }
set 'theta' var(startAngle) + var(arcDelta)
set 'arcSign' sign(var(arcDelta))
setVars [
    'moveDirX'; (0 - sin(var(theta))) * var(arcSign);
    'moveDirY'; 0;
    'moveDirZ'; cos(var(theta)) * var(arcSign)
]
jump 'applyPosition'

@routeEndLine
setVars [
    'moveDirX'; var(dx);
    'moveDirY'; var(dy);
    'moveDirZ'; var(dz)
]
jump 'applyPosition'

@applyPosition
set 'horizontal' sqrt(var(moveDirX) * var(moveDirX) + var(moveDirZ) * var(moveDirZ))
set 'nextYaw' global(MINECART.var(arg.0).lastYaw)
if var(horizontal) <= 0.001 { jump 'pitchReady' }
set 'nextYaw' global(MINECART.var(arg.0).lastYaw) + wrap(atan2(0 - var(moveDirX), var(moveDirZ)) * 57.29577951308232 - global(MINECART.var(arg.0).lastYaw), -180, 180)

@pitchReady
set 'nextPitch' atan2(0 - var(moveDirY), var(horizontal)) * 57.29577951308232
Entity.tp 'var(arg.0)'
    var(nextX); var(nextY); var(nextZ);
    var(nextYaw); var(nextPitch);
Entity.tp 'global(MINECART.var(arg.0).mount)'
    var(nextX); var(nextY) - 0.5; var(nextZ);
    var(nextYaw); 0;
setGlobal 'MINECART.var(arg.0).lastYaw' var(nextYaw)
if global(MINECART.var(arg.0).canMove) <= 0 { jump 'idle' }

@trigger
setVars [
    'lightX'; floor(var(nextX) - sin(var(nextYaw)));
    'lightY'; floor(var(nextY) + 1);
    'lightZ'; floor(var(nextZ) + cos(var(nextYaw)))
]
if global(MINECART.var(arg.0).lightEnabled) > 0 && (var(lightX) != global(MINECART.var(arg.0).lightX) || var(lightY) != global(MINECART.var(arg.0).lightY) || var(lightZ) != global(MINECART.var(arg.0).lightZ)) {
    World.hideFantomBlock global(MINECART.var(arg.0).lightX); global(MINECART.var(arg.0).lightY); global(MINECART.var(arg.0).lightZ);
    World.getBlock var(lightX); var(lightY); var(lightZ); 'block'
    String.equals *block 'minecraft:air' 'false' 'false' 'isAir'
    if var(isAir) { World.fantomBlock 'minecraft:light' var(lightX); var(lightY); var(lightZ); }
    setGlobals [
        'MINECART.var(arg.0).lightX'; var(lightX);
        'MINECART.var(arg.0).lightY'; var(lightY);
        'MINECART.var(arg.0).lightZ'; var(lightZ)
    ]
}
copyToLocal 'MINECART.var(arg.0).rideSound' 'sound'
if global(MINECART.var(arg.0).canMove) && var(arg.1) && len(sound) > 0 && global(MINECART.var(arg.0).soundCD) < $time {
    setGlobal 'MINECART.var(arg.0).soundCD' $time + global(MINECART.var(arg.0).soundPeriod) - 1
    World.sound *sound
        global(MINECART.var(arg.0).soundVolume); global(MINECART.var(arg.0).soundPitch);
        var(nextX); var(nextY); var(nextZ);
}
if global(MINECART.var(arg.0).canMove) {
    Entity.itemDisplaySetItem *arg.2 'global(MINECART.var(arg.0).movingItem)'
}

wait global(MINECART.var(arg.0).tickDelta) - 2
Entity.getPos 'var(arg.0)' 'pos'
set 'radius' global(MINECART.var(arg.0).triggerRadius)
Shiver.spawnTrigger 'minecart.var(arg.0)' 'global(MINECART.var(arg.0).team)' 0;
    (var(pos.x) + var(radius)); (var(pos.y) + var(radius)); (var(pos.z) + var(radius));
    (var(pos.x) - var(radius)); (var(pos.y) - var(radius)); (var(pos.z) - var(radius));
    [*arg.0] {
        run 'entity/minecart/move' '*' [*arg.0; 1]
    }

copyToLocal 'MINECART.var(arg.0).callID' 'callID'
wait 2
if global(MINECART.var(arg.0).callID) == var(callID) {
    Entity.itemDisplaySetItem *arg.2 'global(MINECART.var(arg.0).normalItem)'
}