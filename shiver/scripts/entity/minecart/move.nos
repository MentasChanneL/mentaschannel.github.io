# Shiver script | REPIS
# Экспериментальная плоская версия движения сюжетной вагонетки.
# Аргументы: 0 - uuid вагонетки; 1 - выполнить движение.
# Все рабочие метки находятся на одном уровне; buildCache возвращается через back.

@entry
if var(arg.1) * global(MINECART.var(arg.0).canMove) <= 0 { jump 'trigger' }
if global(MINECART.var(arg.0).routeLastIndex) <= 0 { jump 'legacyMove' }
copyToLocal 'MINECART.var(arg.0).routeLastIndex' 'lastIndex'
copyToLocal 'MINECART.var(arg.0).routeIndex' 'routeIndex'
copyToLocal 'MINECART.var(arg.0).routeProgress' 'progress'

if var(routeIndex) >= var(lastIndex) {
    setGlobal 'MINECART.var(arg.0).canMove' 0
    jump 'trigger'
}

if global(MINECART.var(arg.0).cacheIndex) == var(routeIndex) { jump 'loadCoefficients' }
set 'back' 'loadCoefficients'
jump 'buildCache'

@loadCoefficients

set 'u2' var(progress) * var(progress)
set 'tangentX' 3 * global(MINECART.var(arg.0).aX) * var(u2) + 2 * global(MINECART.var(arg.0).bX) * var(progress) + global(MINECART.var(arg.0).cX)
set 'tangentY' 3 * global(MINECART.var(arg.0).aY) * var(u2) + 2 * global(MINECART.var(arg.0).bY) * var(progress) + global(MINECART.var(arg.0).cY)
set 'tangentZ' 3 * global(MINECART.var(arg.0).aZ) * var(u2) + 2 * global(MINECART.var(arg.0).bZ) * var(progress) + global(MINECART.var(arg.0).cZ)
set 'tangentLength' sqrt(var(tangentX) * var(tangentX) + var(tangentY) * var(tangentY) + var(tangentZ) * var(tangentZ))
if var(tangentLength) <= 0.001 {
    setGlobal 'MINECART.var(arg.0).canMove' 0
    jump 'trigger'
}

set 'nextProgress' min(1, var(progress) + global(MINECART.var(arg.0).speed) / var(tangentLength))
set 'nextU2' var(nextProgress) * var(nextProgress)
set 'nextU3' var(nextU2) * var(nextProgress)
set 'nextTX' 3 * global(MINECART.var(arg.0).aX) * var(nextU2) + 2 * global(MINECART.var(arg.0).bX) * var(nextProgress) + global(MINECART.var(arg.0).cX)
set 'nextTY' 3 * global(MINECART.var(arg.0).aY) * var(nextU2) + 2 * global(MINECART.var(arg.0).bY) * var(nextProgress) + global(MINECART.var(arg.0).cY)
set 'nextTZ' 3 * global(MINECART.var(arg.0).aZ) * var(nextU2) + 2 * global(MINECART.var(arg.0).bZ) * var(nextProgress) + global(MINECART.var(arg.0).cZ)
set 'horizontal' sqrt(var(nextTX) * var(nextTX) + var(nextTZ) * var(nextTZ))

set 'nextPitch' atan2(0 - var(nextTY), var(horizontal)) * 57.29577951308232
if var(horizontal) <= 0.001 { jump 'keepYaw' }
set 'nextYaw' global(MINECART.var(arg.0).lastYaw) + wrap(atan2(0 - var(nextTX), var(nextTZ)) * 57.29577951308232 - global(MINECART.var(arg.0).lastYaw), -180, 180)
Entity.tp 'var(arg.0)'
    global(MINECART.var(arg.0).aX) * var(nextU3) + global(MINECART.var(arg.0).bX) * var(nextU2) + global(MINECART.var(arg.0).cX) * var(nextProgress) + global(MINECART.var(arg.0).dX);
    global(MINECART.var(arg.0).aY) * var(nextU3) + global(MINECART.var(arg.0).bY) * var(nextU2) + global(MINECART.var(arg.0).cY) * var(nextProgress) + global(MINECART.var(arg.0).dY);
    global(MINECART.var(arg.0).aZ) * var(nextU3) + global(MINECART.var(arg.0).bZ) * var(nextU2) + global(MINECART.var(arg.0).cZ) * var(nextProgress) + global(MINECART.var(arg.0).dZ);
    var(nextYaw); var(nextPitch);
copyToGlobal 'nextYaw' 'MINECART.var(arg.0).lastYaw'
jump 'afterYaw'

@keepYaw
Entity.tp 'var(arg.0)'
    global(MINECART.var(arg.0).aX) * var(nextU3) + global(MINECART.var(arg.0).bX) * var(nextU2) + global(MINECART.var(arg.0).cX) * var(nextProgress) + global(MINECART.var(arg.0).dX);
    global(MINECART.var(arg.0).aY) * var(nextU3) + global(MINECART.var(arg.0).bY) * var(nextU2) + global(MINECART.var(arg.0).cY) * var(nextProgress) + global(MINECART.var(arg.0).dY);
    global(MINECART.var(arg.0).aZ) * var(nextU3) + global(MINECART.var(arg.0).bZ) * var(nextU2) + global(MINECART.var(arg.0).cZ) * var(nextProgress) + global(MINECART.var(arg.0).dZ);
    global(MINECART.var(arg.0).lastYaw); var(nextPitch);
@afterYaw

if var(nextProgress) < 1 { jump 'saveProgress' }
set 'routeIndex' var(routeIndex) + 1
copyToGlobal 'routeIndex' 'MINECART.var(arg.0).routeIndex'
setGlobal 'MINECART.var(arg.0).routeProgress' 0
if var(routeIndex) >= var(lastIndex) { setGlobal 'MINECART.var(arg.0).canMove' 0 }
jump 'trigger'

@saveProgress
copyToGlobal 'nextProgress' 'MINECART.var(arg.0).routeProgress'
jump 'trigger'

@legacyMove
copyToLocal 'MINECART.var(arg.0).direction' 'direction'
list.get 'direction' 0; 'x'
list.get 'direction' 1; 'y'
list.get 'direction' 2; 'z'
Entity.getPos 'var(arg.0)' 'pos'
Entity.tp 'var(arg.0)'
    var(pos.x) + var(x) * global(MINECART.var(arg.0).speed);
    var(pos.y) + var(y) * global(MINECART.var(arg.0).speed);
    var(pos.z) + var(z) * global(MINECART.var(arg.0).speed);
    var(pos.yaw); var(pos.pitch);
jump 'trigger'

@buildCache
copyToLocal 'MINECART.var(arg.0).route' 'route'
set 'i0' max(var(routeIndex) - 1, 0)
set 'i1' var(routeIndex)
set 'i2' var(routeIndex) + 1
set 'i3' min(var(routeIndex) + 2, var(lastIndex))
list.get 'route' var(i0); 'p0'
list.get 'route' var(i1); 'p1'
list.get 'route' var(i2); 'p2'
list.get 'route' var(i3); 'p3'
list.get 'p0' 0; 'p0x'
list.get 'p0' 1; 'p0y'
list.get 'p0' 2; 'p0z'
list.get 'p1' 0; 'p1x'
list.get 'p1' 1; 'p1y'
list.get 'p1' 2; 'p1z'
list.get 'p2' 0; 'p2x'
list.get 'p2' 1; 'p2y'
list.get 'p2' 2; 'p2z'
list.get 'p3' 0; 'p3x'
list.get 'p3' 1; 'p3y'
list.get 'p3' 2; 'p3z'

if var(routeIndex) != 0 { jump 'buildP0Done' }
set 'p0x' 2 * var(p1x) - var(p2x)
set 'p0y' 2 * var(p1y) - var(p2y)
set 'p0z' 2 * var(p1z) - var(p2z)
@buildP0Done

if var(routeIndex) < var(lastIndex) - 1 { jump 'buildP3Done' }
set 'p3x' 2 * var(p2x) - var(p1x)
set 'p3y' 2 * var(p2y) - var(p1y)
set 'p3z' 2 * var(p2z) - var(p1z)
@buildP3Done

set 'dist01' sqrt((var(p1x) - var(p0x)) * (var(p1x) - var(p0x)) + (var(p1y) - var(p0y)) * (var(p1y) - var(p0y)) + (var(p1z) - var(p0z)) * (var(p1z) - var(p0z)))
set 'dist12' sqrt((var(p2x) - var(p1x)) * (var(p2x) - var(p1x)) + (var(p2y) - var(p1y)) * (var(p2y) - var(p1y)) + (var(p2z) - var(p1z)) * (var(p2z) - var(p1z)))
set 'dist23' sqrt((var(p3x) - var(p2x)) * (var(p3x) - var(p2x)) + (var(p3y) - var(p2y)) * (var(p3y) - var(p2y)) + (var(p3z) - var(p2z)) * (var(p3z) - var(p2z)))
set 't01' max(sqrt(var(dist01)), 0.001)
set 't12' max(sqrt(var(dist12)), 0.001)
set 't23' max(sqrt(var(dist23)), 0.001)
set 'r10' var(t12) / var(t01)
set 'r20' var(t12) / (var(t01) + var(t12))
set 'r31' var(t12) / (var(t12) + var(t23))
set 'r32' var(t12) / var(t23)

set 'm1x' (var(p1x) - var(p0x)) * var(r10) - (var(p2x) - var(p0x)) * var(r20) + (var(p2x) - var(p1x))
set 'm1z' (var(p1z) - var(p0z)) * var(r10) - (var(p2z) - var(p0z)) * var(r20) + (var(p2z) - var(p1z))
set 'm2x' (var(p2x) - var(p1x)) - (var(p3x) - var(p1x)) * var(r31) + (var(p3x) - var(p2x)) * var(r32)
set 'm2z' (var(p2z) - var(p1z)) - (var(p3z) - var(p1z)) * var(r31) + (var(p3z) - var(p2z)) * var(r32)

set 's0y' (var(p1y) - var(p0y)) / var(t01)
set 's1y' (var(p2y) - var(p1y)) / var(t12)
set 's2y' (var(p3y) - var(p2y)) / var(t23)
set 'w1' 2 * var(t12) + var(t01)
set 'w2' var(t12) + 2 * var(t01)
set 'w3' 2 * var(t23) + var(t12)
set 'w4' var(t23) + 2 * var(t12)
set 'm1y' 0
set 'm2y' 0
if var(s0y) * var(s1y) <= 0 { jump 'buildM1Done' }
set 'm1y' var(t12) * (var(w1) + var(w2)) / (var(w1) / var(s0y) + var(w2) / var(s1y))
@buildM1Done
if var(s1y) * var(s2y) <= 0 { jump 'buildM2Done' }
set 'm2y' var(t12) * (var(w3) + var(w4)) / (var(w3) / var(s1y) + var(w4) / var(s2y))
@buildM2Done

set 'aX' 2 * var(p1x) - 2 * var(p2x) + var(m1x) + var(m2x)
set 'bX' (0 - 3 * var(p1x)) + 3 * var(p2x) - 2 * var(m1x) - var(m2x)
set 'cX' var(m1x)
set 'dX' var(p1x)
set 'aY' 2 * var(p1y) - 2 * var(p2y) + var(m1y) + var(m2y)
set 'bY' (0 - 3 * var(p1y)) + 3 * var(p2y) - 2 * var(m1y) - var(m2y)
set 'cY' var(m1y)
set 'dY' var(p1y)
set 'aZ' 2 * var(p1z) - 2 * var(p2z) + var(m1z) + var(m2z)
set 'bZ' (0 - 3 * var(p1z)) + 3 * var(p2z) - 2 * var(m1z) - var(m2z)
set 'cZ' var(m1z)
set 'dZ' var(p1z)

copyToGlobal 'aX' 'MINECART.var(arg.0).aX'
copyToGlobal 'bX' 'MINECART.var(arg.0).bX'
copyToGlobal 'cX' 'MINECART.var(arg.0).cX'
copyToGlobal 'dX' 'MINECART.var(arg.0).dX'
copyToGlobal 'aY' 'MINECART.var(arg.0).aY'
copyToGlobal 'bY' 'MINECART.var(arg.0).bY'
copyToGlobal 'cY' 'MINECART.var(arg.0).cY'
copyToGlobal 'dY' 'MINECART.var(arg.0).dY'
copyToGlobal 'aZ' 'MINECART.var(arg.0).aZ'
copyToGlobal 'bZ' 'MINECART.var(arg.0).bZ'
copyToGlobal 'cZ' 'MINECART.var(arg.0).cZ'
copyToGlobal 'dZ' 'MINECART.var(arg.0).dZ'
copyToGlobal 'routeIndex' 'MINECART.var(arg.0).cacheIndex'
jump 'var(back)'

@trigger
wait global(MINECART.var(arg.0).tickDelta) - 1
Entity.getPos 'var(arg.0)' 'pos'
set 'radius' global(MINECART.var(arg.0).triggerRadius)
Shiver.spawnTrigger 'minecart.var(arg.0)' 'global(MINECART.var(arg.0).team)' 0;
    (var(pos.x) + var(radius)); (var(pos.y) + var(radius)); (var(pos.z) + var(radius));
    (var(pos.x) - var(radius)); (var(pos.y) - var(radius)); (var(pos.z) - var(radius));
    [*arg.0] {
        run 'entity/minecart/move' '*' [*arg.0; 1]
    }
