# Shiver script | REPIS
# Функция движения сюжетной вагонетки.
# Аргументы:
# 0 - uuid вагонетки
# 1 - выполнить движение
#
# Горизонталь сглаживается центростремительным Catmull-Rom.
# Высота использует монотонные касательные без вертикальных выбросов.
# Коэффициенты сегмента кэшируются до перехода на следующий.
#
# Оптимизация:
# - длина маршрута и радиус триггера вычисляются один раз в spawn.nos;
# - список маршрута загружается только при перестроении кэша сегмента;
# - квадрат/куб считаются умножением, без вызова pow;
# - движение включается одной проверкой двух числовых флагов.

if var(arg.1) * global(MINECART.var(arg.0).canMove) > 0 {
    copyToLocal 'MINECART.var(arg.0).routeLastIndex' 'lastIndex'

    ifelse var(lastIndex) > 0 {
        copyToLocal 'MINECART.var(arg.0).routeIndex' 'routeIndex'
        copyToLocal 'MINECART.var(arg.0).routeProgress' 'progress'

        ifelse var(routeIndex) < var(lastIndex) {
            # Список маршрута нужен только при смене сегмента.
            if global(MINECART.var(arg.0).cacheIndex) != var(routeIndex) {
                copyToLocal 'MINECART.var(arg.0).route' 'route'

                setVars [
                    'i0'; max(var(routeIndex) - 1, 0);
                    'i1'; var(routeIndex);
                    'i2'; var(routeIndex) + 1;
                    'i3'; min(var(routeIndex) + 2, var(lastIndex))
                ]

                list.get 'route' var(i0); 'p0'
                list.get 'route' var(i1); 'p1'
                list.get 'route' var(i2); 'p2'
                list.get 'route' var(i3); 'p3'

                list.unpack 'p0' ['p0x'; 'p0y'; 'p0z']
                list.unpack 'p1' ['p1x'; 'p1y'; 'p1z']
                list.unpack 'p2' ['p2x'; 'p2y'; 'p2z']
                list.unpack 'p3' ['p3x'; 'p3y'; 'p3z']

                # На концах маршрута используем отражённые точки.
                if var(routeIndex) == 0 {
                    setVars [
                        'p0x'; 2 * var(p1x) - var(p2x);
                        'p0y'; 2 * var(p1y) - var(p2y);
                        'p0z'; 2 * var(p1z) - var(p2z)
                    ]
                }
                if var(routeIndex) >= var(lastIndex) - 1 {
                    setVars [
                        'p3x'; 2 * var(p2x) - var(p1x);
                        'p3y'; 2 * var(p2y) - var(p1y);
                        'p3z'; 2 * var(p2z) - var(p1z)
                    ]
                }

                # Centripetal knot intervals: sqrt(distance).
                # Умножение вместо pow(x, 2) даёт ту же величину.
                set 'dist01' sqrt((var(p1x) - var(p0x)) * (var(p1x) - var(p0x)) + (var(p1y) - var(p0y)) * (var(p1y) - var(p0y)) + (var(p1z) - var(p0z)) * (var(p1z) - var(p0z)))
                set 'dist12' sqrt((var(p2x) - var(p1x)) * (var(p2x) - var(p1x)) + (var(p2y) - var(p1y)) * (var(p2y) - var(p1y)) + (var(p2z) - var(p1z)) * (var(p2z) - var(p1z)))
                set 'dist23' sqrt((var(p3x) - var(p2x)) * (var(p3x) - var(p2x)) + (var(p3y) - var(p2y)) * (var(p3y) - var(p2y)) + (var(p3z) - var(p2z)) * (var(p3z) - var(p2z)))
                setVars [
                    't01'; max(sqrt(var(dist01)), 0.001);
                    't12'; max(sqrt(var(dist12)), 0.001);
                    't23'; max(sqrt(var(dist23)), 0.001)
                ]

                setVars [
                    'r10'; var(t12) / var(t01);
                    'r20'; var(t12) / (var(t01) + var(t12));
                    'r31'; var(t12) / (var(t12) + var(t23));
                    'r32'; var(t12) / var(t23)
                ]

                # Hermite tangents for the segment P1 -> P2.
                setVars [
                    'm1x'; (var(p1x) - var(p0x)) * var(r10) - (var(p2x) - var(p0x)) * var(r20) + (var(p2x) - var(p1x));
                    'm1z'; (var(p1z) - var(p0z)) * var(r10) - (var(p2z) - var(p0z)) * var(r20) + (var(p2z) - var(p1z));
                    'm2x'; (var(p2x) - var(p1x)) - (var(p3x) - var(p1x)) * var(r31) + (var(p3x) - var(p2x)) * var(r32);
                    'm2z'; (var(p2z) - var(p1z)) - (var(p3z) - var(p1z)) * var(r31) + (var(p3z) - var(p2z)) * var(r32)
                ]

                # Для Y используем монотонные касательные PCHIP.
                setVars [
                    's0y'; (var(p1y) - var(p0y)) / var(t01);
                    's1y'; (var(p2y) - var(p1y)) / var(t12);
                    's2y'; (var(p3y) - var(p2y)) / var(t23);
                    'w1'; 2 * var(t12) + var(t01);
                    'w2'; var(t12) + 2 * var(t01);
                    'w3'; 2 * var(t23) + var(t12);
                    'w4'; var(t23) + 2 * var(t12);
                    'm1y'; 0;
                    'm2y'; 0
                ]
                if var(s0y) * var(s1y) > 0 {
                    set 'm1y' var(t12) * (var(w1) + var(w2)) / (var(w1) / var(s0y) + var(w2) / var(s1y))
                }
                if var(s1y) * var(s2y) > 0 {
                    set 'm2y' var(t12) * (var(w3) + var(w4)) / (var(w3) / var(s1y) + var(w4) / var(s2y))
                }

                # C(u) = a*u^3 + b*u^2 + c*u + d.
                setVars [
                    'aX'; 2 * var(p1x) - 2 * var(p2x) + var(m1x) + var(m2x);
                    'bX'; (0 - 3 * var(p1x)) + 3 * var(p2x) - 2 * var(m1x) - var(m2x);
                    'cX'; var(m1x);
                    'dX'; var(p1x);
                    'aY'; 2 * var(p1y) - 2 * var(p2y) + var(m1y) + var(m2y);
                    'bY'; (0 - 3 * var(p1y)) + 3 * var(p2y) - 2 * var(m1y) - var(m2y);
                    'cY'; var(m1y);
                    'dY'; var(p1y);
                    'aZ'; 2 * var(p1z) - 2 * var(p2z) + var(m1z) + var(m2z);
                    'bZ'; (0 - 3 * var(p1z)) + 3 * var(p2z) - 2 * var(m1z) - var(m2z);
                    'cZ'; var(m1z);
                    'dZ'; var(p1z)
                ]

                setGlobals [
                    'MINECART.var(arg.0).aX'; var(aX);
                    'MINECART.var(arg.0).bX'; var(bX);
                    'MINECART.var(arg.0).cX'; var(cX);
                    'MINECART.var(arg.0).dX'; var(dX);
                    'MINECART.var(arg.0).aY'; var(aY);
                    'MINECART.var(arg.0).bY'; var(bY);
                    'MINECART.var(arg.0).cY'; var(cY);
                    'MINECART.var(arg.0).dY'; var(dY);
                    'MINECART.var(arg.0).aZ'; var(aZ);
                    'MINECART.var(arg.0).bZ'; var(bZ);
                    'MINECART.var(arg.0).cZ'; var(cZ);
                    'MINECART.var(arg.0).dZ'; var(dZ);
                    'MINECART.var(arg.0).cacheIndex'; var(routeIndex)
                ]
            }

            # Tangent at the current point determines the step length.
            set 'u2' var(progress) * var(progress)
            setVars [
                'tangentX'; 3 * global(MINECART.var(arg.0).aX) * var(u2) + 2 * global(MINECART.var(arg.0).bX) * var(progress) + global(MINECART.var(arg.0).cX);
                'tangentY'; 3 * global(MINECART.var(arg.0).aY) * var(u2) + 2 * global(MINECART.var(arg.0).bY) * var(progress) + global(MINECART.var(arg.0).cY);
                'tangentZ'; 3 * global(MINECART.var(arg.0).aZ) * var(u2) + 2 * global(MINECART.var(arg.0).bZ) * var(progress) + global(MINECART.var(arg.0).cZ)
            ]
            set 'tangentLength' sqrt(var(tangentX) * var(tangentX) + var(tangentY) * var(tangentY) + var(tangentZ) * var(tangentZ))

            ifelse var(tangentLength) > 0.001 {
                set 'nextProgress' min(1, var(progress) + global(MINECART.var(arg.0).speed) / var(tangentLength))
                set 'nextU2' var(nextProgress) * var(nextProgress)
                set 'nextU3' var(nextU2) * var(nextProgress)

                # New tangent. Position is evaluated directly in Entity.tp.
                setVars [
                    'nextTX'; 3 * var(aX) * var(nextU2) + 2 * var(bX) * var(nextProgress) + var(cX);
                    'nextTY'; 3 * var(aY) * var(nextU2) + 2 * var(bY) * var(nextProgress) + var(cY);
                    'nextTZ'; 3 * var(aZ) * var(nextU2) + 2 * var(bZ) * var(nextProgress) + var(cZ)
                ]
                set 'horizontal' sqrt(var(nextTX) * var(nextTX) + var(nextTZ) * var(nextTZ))

                ifelse var(horizontal) > 0.001 {
                    set 'nextYaw' global(MINECART.var(arg.0).lastYaw) + wrap(atan2(0 - var(nextTX), var(nextTZ)) * 57.29577951308232 - global(MINECART.var(arg.0).lastYaw), -180, 180)
                } {
                    copyToLocal 'MINECART.var(arg.0).lastYaw' 'nextYaw'
                }
                set 'nextPitch' atan2(0 - var(nextTY), var(horizontal)) * 57.29577951308232

                Entity.tp 'var(arg.0)'
                    var(aX) * var(nextU3) + var(bX) * var(nextU2) + var(cX) * var(nextProgress) + var(dX);
                    var(aY) * var(nextU3) + var(bY) * var(nextU2) + var(cY) * var(nextProgress) + var(dY);
                    var(aZ) * var(nextU3) + var(bZ) * var(nextU2) + var(cZ) * var(nextProgress) + var(dZ);
                    var(nextYaw); var(nextPitch);
                setGlobals ['MINECART.var(arg.0).lastYaw'; var(nextYaw)]

                ifelse var(nextProgress) >= 1 {
                    set 'routeIndex' var(routeIndex) + 1
                    setGlobals ['MINECART.var(arg.0).routeIndex'; var(routeIndex)]
                    setGlobal 'MINECART.var(arg.0).routeProgress' 0
                    if var(routeIndex) >= var(lastIndex) {
                        setGlobal 'MINECART.var(arg.0).canMove' 0
                    }
                } {
                    setGlobals ['MINECART.var(arg.0).routeProgress'; var(nextProgress)]
                }
            } {
                setGlobal 'MINECART.var(arg.0).canMove' 0
            }
        } {
            # All route segments have been completed.
            setGlobal 'MINECART.var(arg.0).canMove' 0
        }
    } {
        # Legacy movement using a fixed direction when route is empty.
        copyToLocal 'MINECART.var(arg.0).direction' 'direction'
        list.get 'direction' 0; 'x'
        list.get 'direction' 1; 'y'
        list.get 'direction' 2; 'z'
        Entity.getPos 'var(arg.0)' 'pos'
        Entity.tp 'var(arg.0)'
            var(pos.x) + var(x) * global(MINECART.var(arg.0).speed);
            var(pos.y) + var(y) * global(MINECART.var(arg.0).speed);
            var(pos.z) + var(z) * global(MINECART.var(arg.0).speed);
            var(pos.yaw); var(pos.pitch);
    }
}

@trigger
wait global(MINECART.var(arg.0).tickDelta) - 1
Entity.getPos 'var(arg.0)' 'pos'
set 'radius' global(MINECART.var(arg.0).triggerRadius)

Shiver.spawnTrigger 'minecart.var(arg.0)' 'global(MINECART.var(arg.0).team)' 0;
    (var(pos.x) + var(radius)); (var(pos.y) + var(radius)); (var(pos.z) + var(radius));
    (var(pos.x) - var(radius)); (var(pos.y) - var(radius)); (var(pos.z) - var(radius));
    [*arg.0] {
        run 'entity/minecart/move' '*' [*arg.0; 1]
    }
