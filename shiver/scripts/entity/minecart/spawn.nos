# Shiver script | REPIS
# Спавн сюжетной вагонетки.
# Аргументы:
# 0 - местоположение спавна [x, y, z, yaw, pitch]
# 1 - список триггеров [[x; y; z; script; args], ...]
# 2 - модель - предмет
# 3 - смещение модели [x, y, z]
# 4 - размер модели [x, y, z]
# 5 - поворот модели [yaw, pitch, roll]
# 6 - размер хитбокса
# 7 - включить движение
# 8 - команда
# 9 - tick интервал
# 10 - скорость (блоков за один шаг)
# 11 - маршрут как список точек [ [x, y, z], ... ]
# 12 - модель во время движения (пустая строка = не переключать)
# 13 - звук езды (пустая строка = отключён)
# 14 - громкость звука
# 15 - высота звука
# 16 - период звука в тиках (0 = отключён)
# 17 - излучать ли свет перед вагонеткой (1/0)
# 18 - скрипт-события при срабатывании триггера толкания, передает uuid вагонетки
# Модель движется непосредственно по точкам маршрута.
# Невидимый ItemDisplay на 0.5 блока ниже служит носителем хитбокса.

list.get 'arg.0' 0; 'pos_x'
list.get 'arg.0' 1; 'pos_y'
list.get 'arg.0' 2; 'pos_z'
list.get 'arg.0' 3; 'yaw'

Entity.spawnItemDisplay 'model' *pos_x; *pos_y; *pos_z; *yaw; 0; *arg.2
Entity.displayTeleportDuration *model var(arg.9) + 1;
setGlobals [
    'MINECART'; *model;
    'MINECART.var(model).triggers'; *arg.1;
    'MINECART.var(model).route'; *arg.11;
    'MINECART.var(model).canMove'; *arg.7;
    'MINECART.var(model).team'; *arg.8;
    'MINECART.var(model).tickDelta'; *arg.9;
    'MINECART.var(model).speed'; *arg.10;
    'MINECART.var(model).normalItem'; *arg.2;
    'MINECART.var(model).movingItem'; *arg.12;
    'MINECART.var(model).rideSound'; *arg.13;
    'MINECART.var(model).soundVolume'; *arg.14;
    'MINECART.var(model).soundPitch'; *arg.15;
    'MINECART.var(model).soundPeriod'; *arg.16;
    'MINECART.var(model).lightEnabled'; *arg.17;
    'MINECART.var(model).onPush'; *arg.18
]
setGlobals [
    'MINECART.var(model).started'; 0;
    'MINECART.var(model).routeIndex'; 0;
    'MINECART.var(model).routeProgress'; 0;
    'MINECART.var(model).routeLastIndex'; len(arg.11) - 1;
    'MINECART.var(model).triggerRadius'; var(arg.6) / 2 + 1.25;
    'MINECART.var(model).lightX'; *pos_x;
    'MINECART.var(model).lightY'; var(pos_y) + 1;
    'MINECART.var(model).lightZ'; *pos_z;
    'MINECART.var(model).lastYaw'; *yaw;
    'MINECART.var(model).position'; '{"x": var(pos_x), "y": var(pos_y), "z": var(pos_z), "yaw": 0, "pitch": 0}'
]

list.unpack 'arg.3' ['x'; 'y'; 'z']
Entity.displaySetOffset *model *x; *y; *z;
list.unpack 'arg.4' ['x'; 'y'; 'z']
Entity.displaySetScale *model *x; *y; *z;
list.unpack 'arg.5' ['yaw'; 'pitch'; 'roll']
Entity.displayRotations *model *yaw; *pitch; *roll; 'set'

Entity.spawnItemDisplay 'mount' *pos_x; var(pos_y) - 0.5; *pos_z; *yaw; 0; 'global(EMPTY_ITEMSTACK)'
Entity.displayTeleportDuration *mount var(arg.9) + 1;
setGlobal 'MINECART.var(model).mount' *mount

Entity.spawn 'hitbox' *pos_x; *pos_y; *pos_z; 'e2lkOiJtaW5lY3JhZnQ6cGlnX3NwYXduX2VnZyIsIGNvdW50OjEsIGNvbXBvbmVudHM6eyJtaW5lY3JhZnQ6ZW50aXR5X2RhdGEiOntpZDoic2h1bGtlciIsIFNpbGVudDoxYiwgSW52dWxuZXJhYmxlOjFiLCBOb0FJOjFifX19'
setGlobal 'MINECART.var(model).hitbox' *hitbox
setGlobal 'MINECART.var(model).hitboxSize' *arg.6
Entity.attribute *hitbox 'id' *arg.6;
Entity.rideOn *hitbox *mount

run 'entity/minecart/move' '*' [*model; 0]
