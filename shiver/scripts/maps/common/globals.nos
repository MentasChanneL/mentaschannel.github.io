# Shiver map script | REPIS
# Общие глобальные переменные
# Завершает раунд, игроков выбрасывает в меню
setGlobal 'GAMESTAGE_END' 4
# В этой стадии тикает игрок
setGlobal 'GAMESTAGE_GAME' 3
# Используется при погодтовке мира и в катсценах
setGlobal 'GAMESTAGE_CUTSCENE' 2

setGlobal 'TEAM_SURVIVORS' 'In_Game'
setGlobal 'TEAM_SPECTATORS' 'In_Spectators'
setGlobal 'TEAM_ZOMBIES' 'ENEMIES'

# Стата побед
setGlobal 'STAT_WINS' 'wins'
# Стата игр
setGlobal 'STAT_GAMES' 'games'

setGlobal 'POINT_BONUS' 1

setGlobal 'CINEMATIC_LINES' '<color:#000033><font:shiver:frame>0'
setGlobal 'BLACK_SCREEN' '<color:#000000><font:shiver:hud>0'
setGlobal 'LORE_PREFIX' '<color:#dbd5b8>'
setGlobal 'LORE_SPEED' 1
setGlobal 'EMPTY_ITEMSTACK' 'e30='
setGlobal 'WAVE' 0
setGlobal 'WAVE_INCOMING_RUN' 0