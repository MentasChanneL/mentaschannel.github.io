# Shiver map script | REPIS
# Плавный сброс мутации
# Аргументы:
# 0 - на сколько сбросить 1-100
# 1 - скорость (2 - по умолч)

if global(MUTATION_OBJECTIVE) <= 0 || global(MUTATION_OBJECTIVE) >= global(MAX_MUTATION_OBJECTIVE) || var(arg.0) < 1 { jump 'return' }

set 'arg.0' floor(var(arg.0))
if !var(arg.1) { set 'arg.1' 2; }

@reset
    set 'arg.0' var(arg.0) - 1
    setGlobal 'MUTATION_OBJECTIVE' global(MUTATION_OBJECTIVE) - 1
    if global(ENABLE_MUTATION) {
        run 'maps/common/obj/display_mutation' '*' [floor((global(MUTATION_OBJECTIVE) / global(MAX_MUTATION_OBJECTIVE)) * 100)]
    }
    wait *arg.1
    if var(arg.0) && global(MUTATION_OBJECTIVE) > 0 { jump 'reset' }
@return pass