# Shiver map script | REPIS
# Скрипт для карт на прохождение. Вызвать после подготовки НЕ линейно.
# Перед вызовом установить глобальные переменные:
#    MIN_ZOMBIE_COUNT - минимальное количество одновременных зомби
#    MAX_ZOMBIE_COUNT - максимальное количество одновременных зомби
#    ZOMBIE_PER_PLAYER - сколько дополнительных зомби, приходится на каждого игрока
#    ZOMBIE_SPAWN - координаты спавна зомби, x y z yaw pitch
# Управляющие глобальные переменные:
#    MAX_MUTATION_OBJECTIVE - максимальное время мутации или -1 для отключения
#    MUTATION_OBJECTIVE - текущее время мутации
#    ZOMBIE_SPAWN - координаты спавна зомби, x y z yaw pitch
#    ZOMBIE_TYPES_OBJECTIVE - список типов зомби для спавна
#    PAUSE_OBJECTIVE - если 1, скрипт на паузе
#    STOP_OBJECTIVE - убить скрипт

@tick
if global(STOP_OBJECTIVE) {
    jump 'return'
}

if global(PAUSE_OBJECTIVE) {
    wait 40
    jump 'tick'
}

if global(MUTATION_OBJECTIVE) < global(MAX_MUTATION_OBJECTIVE) {
    setGlobal 'MUTATION_OBJECTIVE' global(MUTATION_OBJECTIVE) + 1
    set 'mutationProcent' floor((global(MUTATION_OBJECTIVE) / global(MAX_MUTATION_OBJECTIVE)) * 100)
    Shiver.setBossbarTitle '<font:shiver:smol>0<font:minecraft:default><tr:shiver.gui.zombie_resistence:"var(mutationProcent)%">'
}

if global(MUTATION_OBJECTIVE) > global(MAX_MUTATION_OBJECTIVE) && global(MAX_MUTATION_OBJECTIVE) < 0 {
    setGlobal 'MUTATION_OBJECTIVE' 0
    Shiver.setBossbarTitle ''
}

set 'need' min(floor(global(MIN_ZOMBIE_COUNT) + global(SURVIVORS_COUNT) * global(ZOMBIE_PER_PLAYER)), global(MAX_ZOMBIE_COUNT))
if global(ENEMIES_COUNT) < var(need) && len(ZOMBIE_SPAWN) >= 5 {
    copyToLocal 'ZOMBIE_TYPES_OBJECTIVE' 'types'
    if len(types) > 0 {
        set 'index' floor($random * len(types))
        list.get 'types' var(index); 'type'
        copyToLocal 'pos' 'ZOMBIE_SPAWN'
        list.get 'pos' 0; 'x'
        list.get 'pos' 1; 'y'
        list.get 'pos' 2; 'z'
        list.get 'pos' 3; 'yaw'
        list.get 'pos' 4; 'pitch'
        Shiver.ent '*' 'var(type)' var(x); var(y); var(z); var(yaw); var(pitch);
    }
}

wait 10
# TODO сделать мутацию
wait 10
jump 'tick'

@return pass