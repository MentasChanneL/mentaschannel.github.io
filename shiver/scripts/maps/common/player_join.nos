# Shiver map script | REPIS
# Общий скрипт на вход игрока
# Аргументы:
# 0 - Игрок
# 1 - Причина (1 - by User, 2 - by Script, 3 - antidot)
# 2 - Выдать кит старт 0/1
# 3 - Спавн от клонов 0/1
# 4 - X координата места спавна, если клон не найден
# 5 - Y координата места спавна, если клон не найден
# 6 - Z координата места спавна, если клон не найден
# 7 - Yaw координата места спавна, если клон не найден
# 8 - Pitch координата места спавна, если клон не найден

set 'player' 'var(arg.0)'
set 'reason' var(arg.1)

if var(reason) == 1 {
    Shiver.getSTAGE 'stage'
    if var(stage) == global(GAMESTAGE_CUTSCENE) {
        Shiver.resetPlayer *player
        Entity.effect *player 'invisibility' -1; 0; 0; 0; 1;
        Entity.effect *player 'blindness' -1; 0; 0; 0; 1;
        Player.gamemode *player 'spectator'
        Player.disableMove *player 999999
        jump 'return'
    }
    message '<#D8D6D6>+ var(player)'
}

if var(reason) < 3 {
    Player.sendBedAnimation *player
    if var(arg.3) {
        Shiver.tpPlayerToClone *player var(arg.4); var(arg.5); var(arg.6); var(arg.7); var(arg.8);
    }
    if !var(arg.3) {
        Entity.tp *player var(arg.4); var(arg.5); var(arg.6); var(arg.7); var(arg.8);
    }
    Shiver.resetPlayer *player
    # Выдача рюкзака цвета его рейтинга
    if var(arg.2) > 0 {
        Shiver.getPlayerRate *player '*' '*' '*' 'color'
        if len(color) > 6 {
            # Вырезаем # из цвета
            String.sub 1; len(color); 'var(color)' 'color'
        }
        hexToDec 'var(color)' 'color'
        Shiver.addItem *player 'item.kit_selection' '{"minecraft:dyed_color": var(color)}'
    }
    Player.disableMove *player 0
    jump 'return'
}

if var(reason) == 3 {
    Player.disableMove *player 0
}
@return pass