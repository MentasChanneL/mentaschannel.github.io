# Shiver map script | REPIS
# Скрипт для запуска цепочки камер
# Аргументы:
#   0 - Список камер

if len(arg.0) == 0 { jump 'endcam' }

forEach '*' 'camera' 'arg.0' {
    Shiver.spawnCamera 'var(camera)'
}
wait 2
set 'cam' 0
set 'clen' len(arg.0)
@wcam
    list.get 'arg.0' var(cam); 'camera'
    Shiver.getCameraDuration 'var(camera)' 'duration'
    Shiver.title 0; var(duration) + 40; 40; 'global(CINEMATIC_LINES)' ''
    Shiver.startCamera 'var(camera)' 0
    wait var(duration)
    set 'cam' var(cam) + 1
    if var(cam) < var(clen) { jump 'wcam' }
Shiver.respawnSpectators
@endcam pass