# Shiver map script | REPIS
# Player join in game event
# Variables:
# - player - Player
# - reason - Player join reason (1 - by User, 2 - by Script, 3 - antidot)

setGlobal 'var(player).ifFalled' 0

runInLine 'maps/common/player_join' [
    'var(player)';
    var(reason);
    1;
    218; 42; -75; 0; 0
]