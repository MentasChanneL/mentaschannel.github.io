# Shiver map script | REPIS
# Загрузочный скрипт карты Маяк

# Запуск, настройка
loadScript 'maps/map2/start'
loadScript 'entity/minecart/spawn'
loadScript 'entity/minecart/move'
runInLine 'maps/common/_load' [2]
setGlobal 'MAP_TITLE' '<white>⛏ <tr:shiver.map.global(MAP)>'
setGlobal 'LOOT_CHANCE' 0.7
setGlobal 'PREPARE_TIME' 90
setGlobal 'TICK_HANDLER' 'maps/map2/start'
setGlobal 'MAX_MUTATION_OBJECTIVE' 300
setGlobal 'ZOMBIE_SPAWN' [300.5; 9; 9.5; 0; 0]
setGlobal 'ZOMBIE_TYPES_OBJECTIVE' [17]

World.time 16000
runInLine 'maps/common/launch' []
Shiver.music 'shiver:music.theme6' 1; 1;

###########################################################
##                      Катсцены                         ##
###########################################################

parallel '*' [] {
    dict 'tasks'
    dict 'move'
    dict.set 'move' 'pos' '{"x": 310.5, "y": 1.5, "z": -18.5, "yaw": 0, "pitch": 0}'
    dict.set 'move' 'sprint' 1
    dict.setVar 'tasks' 'move' 'move'
    Shiver.spawnClones 310.5; 1.5; -94.5; 'tasks' 2
    Shiver.getCameraDuration 'map2_start1' 'wait'
    wait var(wait) - 5
    list 'types'
    list.add 'types' '14'
    list.add 'types' '2'
    list.add 'types' '4'
    set 'i' 10
    @for
        list.get 'types' floor(len(types) * $random); 'type'
        Shiver.ent 'ent' 'var(type)' 310.5 + ($random * 4 - 2); 1.5; -121.5 + ($random * 4 - 2); 0; 0;
        Entity.moveTo 'var(ent)' 'pathfinding' [[310.5; 1.5; -67.5]]
        set 'i' var(i) - 1
    if var(i) > 0 { jump 'for' }
    Shiver.getCameraDuration 'map2_start2' 'wait'
    wait var(wait) + 1
    Shiver.getClones 'clones'
    dict.values 'clones' 'clones'
    forEach '*' 'ent' 'clones' {
        Entity.tp 'var(ent)' 310.5; 1.5; -37.5; 0; 0;
    }
    wait 40
    Shiver.getProp 'stage0.c4' 'c4'
    Entity.getPos 'var(c4)' 'c4'
    World.sound 'shiver:weapon.c4' 2; 1; var(c4.x); var(c4.y); var(c4.z);
    World.particle 308.5; 2.5; -30.5; '{"type":"flash"}'
    Entity.itemDisplaySetItem 'var(c4)' 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzY1LjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpjbGF5X2JhbGwifQ=='
    wait 20
    World.particle 310; 2.5; -30; '{"type":"explosion_emitter","count":5,"spread":{"first":2.0,"second":2.0}}'
    World.particle 310; 2.5; -30; '{"type":"campfire_cosy_smoke","count":100,"spread":{"first":4.0,"second":4.0},"motion":{"x":0.0,"y":0.01,"z":0.0}}'
    World.particle 310; 2.5; -30; '{"type":"lava","count":100,"spread":{"first":4.0,"second":4.0}}'
    World.sound 'shiver:weapon.c4.explode' 4; 0.8; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'shiver:weapon.c4.explode' 0.7; 0.8; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'minecraft:entity.generic.explode' 1; 1; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'minecraft:entity.generic.explode' 0.7; 1; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'shiver:ambience.obval' 4; 1.1; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'shiver:ambience.obval' 0.2; 1.1; var(c4.x); var(c4.y); var(c4.z);
    Entity.remove 'var(c4)'
    Shiver.removeZombies
    #         [310.5; 3; 0.5; 0; 0];
    run 'entity/minecart/spawn' '*' [
        [332.5; 1.5; -35.5; 0; 0];
        [];
        'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwMDg3LjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpsZWF0aGVyX2hvcnNlX2FybW9yIn0=';
        [0; 0; 0];
        [1; 1; 1];
        [180; 0; 0];
        1;
        0;
        'global(TEAM_SURVIVORS)';
        5;
        0.5;
        [
            [332.5; 1.5; -33.5];
            [332.5; 1.5; -30.5];
            [333.5; 1.5; -29.5];
            [337.5; 1.5; -29.5];
            [338.5; 1.5; -28.5];
            [338.5; 1.5; -24.5];
            [339.5; 1.5; -23.5];
            [343.5; 1.5; -23.5];
            [344.5; 1.5; -24.5];
            [344.5; 1.5; -27.5];
            [344.5; 2.5; -28.5];
            [344.5; 2.5; -31.5];
            [344.5; 5.5; -35.5];
            [344.5; 5.5; -37.5];
            [344.5; 2.5; -41.5];
            [344.5; 2.5; -44];
            [344.5; 1.5; -45.25];
            [344.5; 1.5; -48.5]
        ]
    ]
}

        #[
        #    [310.5; 3; 0.5];
        #    [310.5; 3; 3.5];
        #    [310.5; 3; 33];
        #    [310.5; 2; 34.25];
        #    [310.5; 2; 36.5];
        #    [310.5; 1; 38.5];
        #    [310.5; 1; 40.5];
        #    [310.5; 0; 42.5];
        #    [310.5; 0; 44.5];
        #    [310.5; -1; 46.5];
        #    [310.5; -1; 49.5];
        #    [309.5; -1; 50.5];
        #    [299.5; -1; 50.5]
        #]

Shiver.getAllPlayers 'players'
forEach 'i' 'ply' 'players' {
    Entity.tp 'var(ply)' 327.5; 7; -56.5; 45; 0;
}
wait 5

runInLine 'maps/common/run_cameras' [[
    'map2_start1';
    'map2_start2';
    'map2_start3';
    'map2_start4'
]]
###########################################################

### Спавн игроков
run 'maps/common/initialize_players' '*' [1; 0; 2]
###

wait 20
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Замечательно, мы тут завалены до конца жизни!'
wait var(wait) + 40
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'У этой шахты должен быть второй выход, но...'
wait var(wait) + 40
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Скорее всего он тоже завален. Нужно найти взрывчатку.'
