# Shiver map script | REPIS
# Загрузочный скрипт карты Маяк

# Запуск, настройка
loadScript 'maps/map2/start'
loadScript 'maps/map2/triggers/_load'
runInLine 'maps/common/_load' [2; ['minecart']]
setGlobal 'MAP_TITLE' '<white>⛏ <tr:shiver.map.global(MAP)>'
setGlobal 'LOOT_CHANCE' 0.7
setGlobal 'PREPARE_TIME' 90
setGlobal 'TICK_HANDLER' 'maps/map2/start'
setGlobal 'MAX_MUTATION_OBJECTIVE' 300
setGlobal 'ZOMBIE_TYPES_OBJECTIVE' [16]

World.time 16000
Shiver.setBossbarEffect 'dark_sky'
run 'entity/minecart/_load' '*' []
run 'maps/map2/triggers/_load' '*' []
runInLine 'maps/common/launch' []
Shiver.music 'shiver:music.theme6' 1; 1;

Shiver.spawnTrigger 'tank_suprize' 'global(TEAM_SURVIVORS)' 0; 349.5; 2.5; 130.5; 343.5; -2.5; 123.5; [] {
    World.sound 'shiver:zombie.tank.fall' 2; 0.8; 347.5; 3.5; 116.5;
    World.sound 'shiver:zombie.tank.fall' 2; 0.8; 347.5; 3.5; 116.5;
    World.particle 347.5; 1.5; 116.5; '{"type":"explosion_emitter","count":1}'
    World.setBlocks 1; 'air' 347; 1; 116; 347; 1; 115;
    wait 8
    Shiver.ent '*' '9' 347.5; 3.5; 116.5; 0; 0;
    Shiver.ent '*' '2' 347.5; 3.5; 116.5; 0; 0;
    Shiver.ent '*' '2' 347.5; 3.5; 116.5; 0; 0;
    Shiver.ent '*' '2' 347.5; 3.5; 116.5; 0; 0;
}

Shiver.spawnTrigger 'bridge_fall' 'global(TEAM_SURVIVORS)' 2; 301.5; -4; 76.5; 336.5; -23.5; 101.5; [] {
    forEach '*' 'ply' 'targets' {
        Entity.damage *ply 200; ''
    }
}

Shiver.spawnTrigger 'build_bridge' 'global(TEAM_SURVIVORS)' 0; 311; -1; 59; 315; 2; 65; [] {
    World.cloneBlocks 313; 22; 81; 318; 24; 101; 316; -2; 78; 'true' 'false'
    World.regionToModel 'bridge_pillar' 322.5; 25; 91; 323; 37; 90; 321; 25; 90;
    setGlobal 'BRIDGE_PILLAR' *bridge_pillar
    forEach '*' 'ent' 'bridge_pillar' {
        Entity.tp *ent 321; -15; 88.5; -90; 0;
        Entity.displayTeleportDuration *ent 6;
    }
    setGlobal 'ZOMBIE_TYPES_OBJECTIVE' [16; 2]
}

Shiver.spawnTrigger 'init_arrows' 'global(TEAM_SURVIVORS)' 0; 321; 2; 107; 315; -1; 101; [] {
    World.setBlocks 1; 'stone' 347; 1; 116; 347; 1; 115;
    Entity.spawnItemDisplay 'roll' 318.5; 2.5; 123.5; -90; 0; 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzkuMGZdfX0sY291bnQ6MSxpZDoibWluZWNyYWZ0OnN0cmluZyJ9'
    World.setBlocks 0; 'minecraft:light_gray_stained_glass_pane[east=false,north=true,south=true,waterlogged=false,west=false]' 329; 2; 115; 329; 4; 119;
    Entity.spawnItemDisplay 'gate' 329.5; 2; 117.5; -90; 0; 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwLjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpzdHJpbmcifQ=='
    Entity.displaySetScale *gate 8; 8; 8;
    Entity.displaySetOffset *gate 0; 1.5625; 0;
    Entity.displayTeleportDuration *gate 20;
    World.setBlocks 1; 'air' 326; 5; 117; 326; 5; 117;
    World.setBlocks 1; 'air' 325; 5; 110; 326; 5; 110;
    setGlobals [
        'ARROW_ROLL'; *roll;
        'ARROW_GATE'; *gate
    ]
}

Shiver.addZombieSpawn 'stage1' 0; 1; 300.5; 8.5; 9.5; -90; 0;
Shiver.addZombieSpawn 'stage2' 0; 1; 291.5; 3; 42.5; -45; 0;
Shiver.addZombieSpawn 'stage3' 0; 1; 330.5; 8; 77.5; 45; 0;
Shiver.addZombieSpawn 'stage4' 0; 1; 301.5; 10; 128.5; -135; 0;
Shiver.addZombieSpawn 'stage5' 0; 1; 333.5; 10; 154.5; 180; 0;
Shiver.addZombieSpawn 'stage6' 1.5; 3; 347.5; 12.5; 182.5; 45; 0;

###########################################################
##                      Катсцены                         ##
###########################################################

parallel '*' [] {
    dict 'tasks'
    dict 'move'
    dict.set 'move' 'pos' '{"x": 310.5, "y": 1.5, "z": -18.5, "yaw": 0, "pitch": 0}'
    dict.set 'move' 'sprint' 1
    dict.setVar 'tasks' 'move' 'move'
    Shiver.spawnClones 310.5; 1.5; -94.5; 'tasks' 2
    Shiver.getCameraDuration 'map2_start1' 'wait'
    wait var(wait) - 5
    list 'types'
    list.add 'types' '14'
    list.add 'types' '2'
    list.add 'types' '4'
    set 'i' 10
    @for
        list.get 'types' floor(len(types) * $random); 'type'
        Shiver.ent 'ent' 'var(type)' 310.5 + ($random * 4 - 2); 1.5; -121.5 + ($random * 4 - 2); 0; 0;
        Entity.moveTo *ent 'pathfinding' [[310.5; 1.5; -67.5]]
        Entity.effect *ent 'speed' -1; 1; 0; 0; 1;
        set 'i' var(i) - 1
    if var(i) > 0 { jump 'for' }
    Shiver.getCameraDuration 'map2_start2' 'wait'
    wait var(wait) + 1
    Shiver.getClones 'clones'
    dict.values 'clones' 'clones'
    forEach '*' 'ent' 'clones' {
        Entity.tp *ent 310.5; 1.5; -37.5; 0; 0;
        Entity.moveTo *ent 'pathfinding' [[310.5; 1.5; -18.5]]
    }
    wait 50
    Shiver.getProp 'stage0.c4' 'c4'
    Entity.getPos *c4 'c4'
    World.sound 'shiver:weapon.c4' 2; 1; var(c4.x); var(c4.y); var(c4.z);
    World.particle 308.5; 2.5; -30.5; '{"type":"flash"}'
    Entity.itemDisplaySetItem *c4 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzY1LjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpjbGF5X2JhbGwifQ=='
    wait 20
    World.particle 310; 2.5; -30; '{"type":"explosion_emitter","count":5,"spread":{"first":2.0,"second":2.0}}'
    World.particle 310; 2.5; -30; '{"type":"campfire_cosy_smoke","count":100,"spread":{"first":2.5,"second":2.5},"motion":{"x":0.0,"y":0.01,"z":0.0}}'
    World.particle 310; 2.5; -30; '{"type":"lava","count":100,"spread":{"first":4.0,"second":4.0}}'
    World.sound 'shiver:weapon.c4.explode' 4; 0.8; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'shiver:weapon.c4.explode' 0.7; 0.8; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'minecraft:entity.generic.explode' 1; 1; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'minecraft:entity.generic.explode' 0.7; 1; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'shiver:ambience.obval' 4; 1.1; var(c4.x); var(c4.y); var(c4.z);
    World.sound 'shiver:ambience.obval' 0.2; 1.1; var(c4.x); var(c4.y); var(c4.z);
    Entity.remove *c4
    Shiver.removeZombies
    # TODO make speed 5
    run 'entity/minecart/spawn' '*' [
        [310.5; 3.5; 0.5; 0; 0];
        [
            [307.5; -0.5; 50.5; 'maps/common/obj/reset_mutation'; [20]];
            [315.5; -0.5; 62.5; 'maps/common/obj/reset_mutation'; [70]];
            [318.5; -0.5; 82.5; 'maps/map2/triggers/break_bridge'; [1]];
            [318.5; -0.5; 88.5; 'maps/map2/triggers/break_bridge'; [2]];
            [318.5; -0.5; 94.5; 'maps/map2/triggers/break_bridge'; [3]];
            [318.5; -0.5; 98.5; 'maps/map2/triggers/break_bridge'; [4]];
            [318.5; 2.5; 121.5; 'maps/map2/triggers/change_arrows'; []];
            [359.5; 2.5; 166.5; 'maps/map2/triggers/find_tnt'; []];
            [349.5; 2.5; 166.5; 'maps/map2/triggers/enable_second_generator'; []]
        ];
        'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwMDgyLjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpsZWF0aGVyX2hvcnNlX2FybW9yIn0=';
        [0; 0; 0];
        [1; 1; 1];
        [180; 0; 0];
        1;
        0;
        'global(TEAM_SURVIVORS)';
        1;
        0.35;
        [
            [310.5; 3.5; 0.5];
            [310.5; 3.5; 33.25];
            [310.5; 2.5; 34.25];
            [310.5; 2.5; 37.25];
            [310.5; 1.5; 38.25];
            [310.5; 1.5; 41.25];
            [310.5; 0.5; 42.25];
            [310.5; 0.5; 45.25];
            [310.5; -0.5; 46.25];
            [310.5; -0.5; 49.5];
            [309.5; -0.5; 50.5];
            [299.5; -0.5; 50.5];
            [298.5; -0.5; 51.5];
            [298.5; -0.5; 61.5];
            [299.5; -0.5; 62.5];
            [317.5; -0.5; 62.5];
            [318.5; -0.5; 63.5];
            [318.5; -0.5; 109.75];
            [318.5; 0.5; 110.75];
            [318.5; 0.5; 113.75];
            [318.5; 1.5; 114.75];
            [318.5; 1.5; 117.75];
            [318.5; 2.5; 118.75];
            [318.5; 2.5; 147.5];
            [319.5; 2.5; 148.5];
            [345.5; 2.5; 148.5];
            [346.5; 2.5; 149.5];
            [346.5; 2.5; 165.5];
            [347.5; 2.5; 166.5];
            [359.5; 2.5; 166.5]
        ];
        'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwMDgzLjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpsZWF0aGVyX2hvcnNlX2FybW9yIn0=';
        'minecraft:entity.minecart.riding';
        0.5;
        0.5;
        20;
        1;
        ''
    ]
    wait 10
    Entity.setTags 'global(MINECART.global(MINECART).hitbox)' ['can_ride_sentry'; 1]
    World.particle 310.5; 5.5; -8.5; '{"type":"campfire_signal_smoke","count":100,"spread":{"first":2.5,"second":2.5},"motion":{"x":0.0,"y":-0.01,"z":0.0}}'
    World.particle 310.5; 4.5; -3.5; '{"type":"campfire_signal_smoke","count":100,"spread":{"first":2.5,"second":2.5},"motion":{"x":0.0,"y":-0.01,"z":0.0}}'
}

Shiver.getAllPlayers 'players'
forEach 'i' 'ply' 'players' {
    Entity.tp 'var(ply)' 327.5; 7; -56.5; 45; 0;
}
wait 5

runInLine 'maps/common/run_cameras' [[
    'map2_start1';
    'map2_start2';
    'map2_start3';
    'map2_start4'
]]
###########################################################

### Спавн игроков
run 'maps/common/initialize_players' '*' [1; 0; 2]
###

wait 20
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Замечательно, мы тут завалены до конца жизни!'
wait var(wait) + 40
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'У этой шахты должен быть второй выход, но...'
wait var(wait) + 40
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Скорее всего он тоже завален. Нужно найти взрывчатку.'
