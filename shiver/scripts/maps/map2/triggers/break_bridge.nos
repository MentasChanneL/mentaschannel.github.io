# 0 - stage

if var(stage) == 1 || var(stage) == 3 {
    World.sound 'shiver:ambience.bridge_crack2' 2; 1; 318.5; -1.5; 88.5;
}

if var(stage) == 2 {
    World.sound 'shiver:ambience.bridge_crack1' 2; 1; 318.5; -1.5; 88.5;
    wait 17
    Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Мост трещит! Нужно быстрее перебираться!'
}

if var(stage) != 4 { jump 'return' }

World.cloneBlocks 313; 22; 81; 318; 24; 101; 316; -2; 78; 'true' 'false'

setVars [
    'x'; 318; 
    'y'; -2;
    'z'; 88
]

parallel '*' [] {
    copyToLocal 'BRIDGE_PILLAR' 'bridge_pillar'
    setVars [
        'p'; 1;
        't'; 11
    ]

    @fall
    wait 5
    setVars [
        'p'; var(p) * 1.5;
        't'; var(t) - 1
    ]
    forEach '*' 'ent' 'bridge_pillar' {
        Entity.setCoord *ent 'pitch' *p;
    }
    if *t { jump 'fall' }
    wait 5

    World.sound 'shiver:box.break' 5; 0.5; 333; -15; 88;
    World.sound 'shiver:zombie.tank.fall' 5; 0.75; 333; -15; 88;
    World.sound 'shiver:zombie.tank.fall' 5; 0.75; 333; -15; 88;
    Shiver.getPlayers 'players'
    Player.sendDamageAnimation *players 270;
    parallel '*' [] {
        World.particle 326.5; -14.5; 88.5; '{"type":"explosion_emitter","count":20, "spread": {"first": 6, "second": 2}}'
        wait 1
        World.particle 326.5; -14.5; 88.5; '{"type":"campfire_signal_smoke","count":90, "spread": {"first": 6, "second": 2},"motion":{"x":0.0,"y":0.02, "z":0.0}}'
        wait 1
        World.particle 326.5; -14.5; 88.5; '{"type":"campfire_signal_smoke","count":90, "spread": {"first": 6, "second": 2},"motion":{"x":0.0,"y":0.04,"z":0.0}}'
        wait 1
        World.particle 326.5; -14.5; 88.5; '{"type":"campfire_signal_smoke","count":100, "spread": {"first": 8, "second": 2},"motion":{"x":0.0,"y":0.05,"z":0.0}}'
        wait 1
        World.particle 324.5; 10.5; 88.5; '{"type":"block","count":100, "spread": {"first": 6, "second": 2}, "material": "stone"}'
        wait 1
        World.particle 324.5; 10.5; 88.5; '{"type":"block","count":100, "spread": {"first": 6, "second": 2}, "material": "stone"}'
        wait 1
        set 'i' 10
        @for
        World.particle 324.5; 10.5; 88.5; '{"type":"block","count":100, "spread": {"first": 10, "second": 2}, "material": "stone"}'
        set 'i' var(i) -1
        wait 1
        if *i { jump 'for' }
    }

    wait 1
    # Первый отскок — 8 градусов
    set 'angle' 90
    set 't' 0
    @bounce1
    wait 5
    set 't' min(var(t) + 0.5, 1)
    set 'angle' 90 - 8 * sin(var(t) * 180)
    forEach '*' 'ent' 'bridge_pillar' {
        Entity.setCoord *ent 'pitch' *angle;
    }
    if var(t) < 1 {
        jump 'bounce1'
    }

    # Второй отскок — 4 градуса
    set 'angle' 90
    set 't' 0
    @bounce2
    wait 5
    set 't' min(var(t) + 0.5, 1)
    set 'angle' 90 - 4 * sin(var(t) * 180)
    forEach '*' 'ent' 'bridge_pillar' {
        Entity.setCoord *ent 'pitch' *angle;
    }
    if var(t) < 1 {
        jump 'bounce2'
    }
}

parallel '*' [*x; *y; *z] {
    wait 24
    World.sound 'shiver:ambience.bridge_crack2' 2; 0.6; *arg.0; *arg.1; *arg.2;
    setVars [
        'len'; 4;
        'segment'; 2;
        'x1'; var(arg.0) + 3; 
        'x2'; var(arg.0) - 2; 
        'y1'; var(arg.1) + 2;
        'y2'; *arg.1;
        'z2'; *arg.2;
        'z4'; *arg.2
    ]
    @loop
        setVars [
            'z1'; var(z2) + var(segment);
            'z3'; var(z4) - var(segment)
        ]
        World.toFallingBlocks '*' *x1; *y1; *z1; *x2; *y2; *z2;
        World.toFallingBlocks '*' *x1; *y1; *z3; *x2; *y2; *z4;
        setVars [
            'z2'; var(z2) + var(segment);
            'z4'; var(z4) - var(segment);
            'len'; var(len) - 1
        ]
        if !var(len) {
            World.cloneBlocks 316; 30; 80; 320; 30; 96; 316; -2; 80; 'false' 'false'
        }
        wait 5
        if var(len) { jump 'loop' }
}

@return pass

# shiver:ambience.bridge_crush