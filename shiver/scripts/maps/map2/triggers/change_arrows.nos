setGlobal 'MINECART.global(MINECART).canMove' 0

Shiver.addClickableBlocks 'start_generator' 'global(TEAM_SURVIVORS)' 1; 324.5; 3.5; 111.5; 324.5; 2.5; 109.5; [] {
    Shiver.removeClickableBlocks 'start_generator'
    parallel '*' [] {
        wait 40
        World.setBlocks 1; 'light' 325; 5; 110; 326; 5; 110;
        wait 20
        World.setBlocks 1; 'light' 326; 5; 117; 326; 5; 117;
    }
    parallel '*' [400] {
        @tick
        World.particle 323.5; 5; 109.5; '{"type": "poof", "count": 4, "spread": {"first": 0.1, "second": 0}}'
        set 'arg.0' var(arg.0) - 1
        wait 3
        if *arg.0 { jump 'tick' }
    }
    setVars [
        'maxTimer'; 60;
        'timer'; 60;
        'requirePressure'; 25;
        'angle'; -90
    ]
    Shiver.getProp 'stage3.generator' 'prop'
    Entity.itemDisplaySetItem *prop 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwMTcwLjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpsZWF0aGVyX2hvcnNlX2FybW9yIn0='
    Shiver.music 'shiver:music.theme7' 1; 1;
    Shiver.addZombieSpawn 'bonus' 0; 1; 323.5; 8.5; 124.5; 180; 0;
    set 'timer' 60
    World.sound 'shiver:ambience.generator2' 2; 1; 323; 2; 110;
    setGlobals [
        'ENABLE_MUTATION'; 0;
        'ZOMBIE_TYPES_OBJECTIVE'; [16; 2; 7; 4; 2]
    ]
    run 'maps/common/obj/reset_mutation' '*' [100]
    @timer
    set 'timer' var(timer) - 1
    setVars [
        'pressure'; round(var(requirePressure) * (1 - var(timer) / var(maxTimer)), 1);
        'angle'; -90 * (var(timer) / var(maxTimer))
    ]
    Shiver.setProgressBar (1 - var(timer) / var(maxTimer)); 0;
    Shiver.setBossbarTitle 'var(pressure)/var(requirePressure)'
    Entity.setCoord 'global(ARROW_ROLL)' 'yaw' *angle
    wait 20
    if *timer { jump 'timer' }
    Entity.offsetCoord 'global(ARROW_GATE)' 'y' 2;
    World.setBlocks 1; 'air' 329; 3; 115; 329; 2; 119;
    World.sound 'shiver:ambience.heavy_metal_move1' 2; 1; 329; 2; 117;
    setGlobals [
        'ENABLE_MUTATION'; 1;
        'MINECART.global(MINECART).canMove'; 1;
        'ZOMBIE_TYPES_OBJECTIVE'; [16; 2; 7; 2];
        'TNT_GOAL_ARROWS'; 0;
        'TNT_GOAL_OPEN'; 0;
        'TNT_GOAL_NEED'; 3
    ]
    setVars [
        'barrels'; [
            [352.5; 2.5; 168.5];
            [355.5; 2.5; 169.5];
            [361.5; 2.5; 169.5];
            [363.5; 4.5; 166.5];
            [363.5; 4.5; 167.5];
            [363.5; 3.5; 166.5];
            [363.5; 3.5; 167.5];
            [363.5; 2.5; 167.5];
            [363.5; 2.5; 166.5];
            [360.5; 2.5; 162.5];
            [360.5; 2.5; 161.5];
            [360.5; 2.5; 160.5];
            [363.5; 2.5; 159.5];
            [358.5; 2.5; 159.5];
            [355.5; 2.5; 158.5];
            [355.5; 2.5; 159.5];
            [357.5; 2.5; 169.5];
            [357.5; 3.5; 169.5];
            [356.5; 3.5; 169.5];
            [356.5; 2.5; 169.5]
        ];
        'choosedBarrels'; [];
        'tnts'; global(TNT_GOAL_NEED)
    ]
    forEach '*' 'barrel' 'barrels' {
        list.unpack 'barrel' ['x'; 'y'; 'z']
        World.setBlockParam 'open' 'false' *x; *y; *z; *x; *y; *z;
    }
    @dowhile
    setVars [
        'tnts'; var(tnts) - 1;
        'index'; floor($random * len(barrels))
    ]
    list.get 'barrels' *index; 'barrel'
    list.remove 'barrels' *index
    list.add 'choosedBarrels' *barrel
    if *tnts { jump 'dowhile' }
    forEach 'i' 'barrel' 'barrels' {
        list.unpack 'barrel' ['x'; 'y'; 'z']
        Shiver.addClickableBlocks 'barrelvar(i)' 'global(TEAM_SURVIVORS)' 0; *x; *y; *z; *x; *y; *z; [*i] {
            if !global(TNT_GOAL_OPEN) { jump 'return' }
            Shiver.removeClickableBlocks 'barrelvar(arg.0)'
            World.setBlockParam 'open' 'true' *blockX; *blockY; *blockZ; *blockX; *blockY; *blockZ;
            World.sound 'minecraft:block.barrel.open' 1; 1; *blockX; *blockY; *blockZ;
            Player.sendActionbar 'goal' [*player] 40; ['Empty'] 40;
            @return pass
        }
    }
    forEach 'i' 'barrel' 'choosedBarrels' {
        list.unpack 'barrel' ['x'; 'y'; 'z']
        Shiver.addClickableBlocks 'c_barrelvar(i)' 'global(TEAM_SURVIVORS)' 0; *x; *y; *z; *x; *y; *z; [*i] {
            if !global(TNT_GOAL_OPEN) { jump 'return' }
            Shiver.removeClickableBlocks 'c_barrelvar(arg.0)'
            World.setBlockParam 'open' 'true' *blockX; *blockY; *blockZ; *blockX; *blockY; *blockZ;
            setVars [
                'particleX'; var(blockX) + var(faceX);
                'particleY'; var(blockY) + var(faceY);
                'particleZ'; var(blockZ) + var(faceZ)
            ]
            World.particle *particleX; *particleY; *particleZ; '{"type": "poof", "count": 2}'
            World.sound 'minecraft:block.barrel.open' 1; 1; *blockX; *blockY; *blockZ;
            Player.sendActionbar 'goal' [*player] 40; ['+1'] 40;
            setGlobal 'TNT_GOAL_NEED' global(TNT_GOAL_NEED) - 1
            if global(TNT_GOAL_NEED) { jump 'return' }
            # TNT searching complete
            Entity.setCoord 'global(MINECART)' 'yaw' 90;
            wait 5
            Entity.itemDisplaySetItem 'global(MINECART)' 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwMDg0LjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpsZWF0aGVyX2hvcnNlX2FybW9yIn0='
            Entity.displayTeleportDuration 'global(MINECART)' global(MINECART.global(MINECART).teleportDuration);
            setGlobals [
                'MINECART.global(MINECART).canMove'; 1;
                'MINECART.global(MINECART).normalItem'; 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwMDg0LjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpsZWF0aGVyX2hvcnNlX2FybW9yIn0=';
                'MINECART.global(MINECART).movingItem'; 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwMDg1LjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpsZWF0aGVyX2hvcnNlX2FybW9yIn0=';
                'MINECART.global(MINECART).routeIndex'; 0;
                'MINECART.global(MINECART).route'; [
                    [359.5; 2.5; 166.5];
                    [359.5; 2.5; 166.5];
                    [358.5; 2.5; 166.5];
                    [347.5; 2.5; 166.5];
                    [346.5; 2.5; 167.5];
                    [346.5; 2.5; 185.5];
                    [345.5; 2.5; 186.5];
                    [345.25; 2.5; 186.5];
                    [344.25; 3.5; 186.5];
                    [341.25; 3.5; 186.5];
                    [340.25; 4.5; 186.5];
                    [337.25; 4.5; 186.5];
                    [336.25; 5.5; 186.5];
                    [334.5; 5.5; 186.5];
                    [333.5; 5.5; 187.5];
                    [333.5; 5.5; 187.75];
                    [333.5; 8.5; 190.75];
                    [333.5; 8.5; 194.5];
                    [334.5; 8.5; 195.5];
                    [334.75; 8.5; 195.5];
                    [335.75; 9.5; 195.5];
                    [338.75; 9.5; 195.5];
                    [339.75; 10.5; 195.5];
                    [342.75; 10.5; 195.5];
                    [345.75; 13.5; 195.5];
                    [348.75; 13.5; 195.5];
                    [349.75; 14.5; 195.5];
                    [368.5; 14.5; 195.5];
                    [368.5; 14.5; 195.5]
                ];
                'MINECART.global(MINECART).triggers'; [
                    [349.5; 2.5; 166.5; 'maps/map2/triggers/check_second_arrows'; []];
                    [369.5; 14.5; 195.5; 'maps/map2/triggers/end_game'; []]
                ]
            ]
            message 'task complete'
            @return pass
        }
    }
}

Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Стрелки не переведены... Поищем генератор.'

wait 80

message 'new goal'
World.privateSound 'shiver:ambience.button15' 1; 0.5;