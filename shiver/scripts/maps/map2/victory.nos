# Shiver map script | REPIS

run 'maps/common/victory' '*' [
    ['map2_end1'; 'map2_end2'];
    2;
    'kit.rich';
    196.5; 50; -106.5
]

wait 30

World.sound 'entity.generic.explode' 10; 0.5; 367.5; 14.5; 195.5
World.sound 'entity.generic.explode' 10; 0.5; 367.5; 14.5; 195.5
World.sound 'shiver:zombie.tank.fall' 10; 0.5; 367.5; 14.5; 195.5
World.particle 367.5; 14.5; 195.5; '{"type": "explosion_emitter", "count": 4, "spread": {"first": 2, "second": 2}}'
World.particle 367.5; 14.5; 195.5; '{"type": "lava", "count": 100, "spread": {"first": 3, "second": 3}}'
World.particle 367.5; 14.5; 195.5; '{"type": "campfire_cosy_smoke", "count": 100, "spread": {"first": 3, "second": 3},"motion":{"x":0.0,"y":0.02, "z":0.0}}'
World.toFallingBlocks 'blocks' 368; 14; 197; 372; 17; 193;
forEach '*' 'ent' 'blocks' {
    Entity.setVelocity *ent -0.4 - 0.3 * $random; 0.1; 0;
}
World.cloneBlocks 366; 14; 178; 370; 15; 174; 368; 14; 197; 'false' 'false'
dict 'tasks'
dict 'move'
dict.set 'move' 'pos' '{"x": 396, "y": 14, "z": 195, "yaw": 0, "pitch": 0}'
dict.set 'move' 'sprint' 1
dict.setVar 'tasks' 'move' 'move'
Shiver.spawnClones 360.5; 14.5; 195.5; 'tasks' 1.5;
Entity.getMembers 'global(MINECART)' 0; 'passengers'
forEach '*' 'ent' 'passengers' {
    Entity.damage *ent 222; ''
}
Entity.remove 'global(MINECART)'
Shiver.removeZombies 1
Shiver.getPlayers 'players'
forEach '*' 'ply' 'players' {
    Shiver.stopMusic *ply
}