# Shiver map script | REPIS
# Загрузочный скрипт карты Маяк

# Запуск, настройка
runInLine 'maps/common/_load' [1]
setGlobal 'MAP_TITLE' '<white>☷ <tr:shiver.map.global(MAP)>'
setGlobal 'LOOT_CHANCE' 0.6
setGlobal 'PREPARE_TIME' 150
setGlobal 'TICK_HANDLER' 'maps/common/wave_tick'
World.time 12800
runInLine 'maps/common/launch' []
Shiver.music 'shiver:music.theme9' 1; 1;

Shiver.addZombieSpawn 'metro' 241.5; 17; 217.5; 0; 0;
Shiver.addZombieSpawn 'city' 306; 23; 297.5; 160; 0;
Shiver.spawnTrigger 'victim1' 'global(TEAM_SURVIVORS)' 0; 185; 23; 293; 183; 28; 295; {
    Shiver.ent '*' '6' 179.5; 26; 295.5; -45; 0;
}
Shiver.spawnTrigger 'victim2' 'global(TEAM_SURVIVORS)' 0; 185; 26; 296; 180; 29; 299; {
    Shiver.ent '*' '6' 181.5; 26.5; 301.5; -45; 0;
}
Shiver.spawnTrigger 'jumper' 'global(TEAM_SURVIVORS)' 0; 260; 30; 275; 259; 33; 278; {
    @tick
        Shiver.ent 'jumper' '12' 259.5; 35.5; 275.5; -45; 0;
        Entity.effect 'var(jumper)' 'resistance' -1; 10; 0; 0; 1;
        World.sound 'shiver:barrel_impact' 2; 0.5; 259; 35; 275;
        wait 20 * 5
    jump 'tick'
}

###########################################################
##                      Катсцены                         ##
###########################################################
dict 'tasks'
dict 'move'
dict.set 'move' 'pos' '{"x": 196, "y": 23, "z": 250, "yaw": 0, "pitch": 0}'
set 'sprint' 0
dict.setVar 'move' 'sprint' 'sprint'
dict.setVar 'tasks' 'move' 'move'
Shiver.spawnClones 196; 23; 298.5; 'tasks' 3.5
Shiver.getClones 'clones'
dict.values 'clones' 'clones_ents'
forEach '*' 'ent' 'clones_ents' {
    Entity.effect 'var(ent)' 'slowness' 70; 127; 0; 0; 1;
}

runInLine 'maps/common/run_cameras' [[
    'map3start1';
    'map3start2'
]]
###########################################################

### Спавн игроков
run 'maps/common/initialize_players' '*' [1]
###

wait 20
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Почти вышли из города, уже виднеется отель.'
wait var(wait) + 40
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Обшарим эту местность и выдвигаемся.'
wait var(wait) + 40
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Надеюсь за нами не было хвоста...'