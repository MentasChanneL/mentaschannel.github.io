# Shiver map script | REPIS

run 'maps/common/victory' '*' [
    ['map3win'];
    2;
    'kit.engi';
    268.5; 5; 293.5;
]

Shiver.music 'shiver:music.theme11' 1; 1;
dict 'tasks'
dict 'move'
dict.set 'move' 'pos' '{"x": 189.5, "y": 23.5, "z": 263.5, "yaw": 0, "pitch": 0}'
set 'sprint' 1
dict.setVar 'move' 'sprint' 'sprint'
dict 'defend'
dict.setVar 'tasks' 'move' 'move'
dict.setVar 'tasks' 'defend' 'defend'
Shiver.spawnClones 227.5; 24.5; 247; 'tasks' 3
Shiver.removeZombies