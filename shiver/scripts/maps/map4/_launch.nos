# Shiver map script | REPIS
# Загрузочный скрипт карты Маяк

# Запуск, настройка
runInLine 'maps/common/_load' [2]
setGlobal 'MAP_TITLE' '<white>⯪ <tr:shiver.map.global(MAP)>'
setGlobal 'LOOT_CHANCE' 0.7
setGlobal 'PREPARE_TIME' 90
setGlobal 'TICK_HANDLER' 'maps/map2/start'
World.time 13100
runInLine 'maps/common/launch' ['street.'; 'water.fire'; 'pool.'; 'final.lamp'; 'hotel_vhod.']
Shiver.music 'shiver:music.theme3' 1; 1;
loadScript 'maps/common/util/spawn_props'
loadScript 'maps/map4/start'

Shiver.addZombieSpawn 'votel_vhod' 2; 3; 194.5; 49.5; -416.5; -135; 0

World.setBlocks 0; 'minecraft:light_gray_stained_glass_pane[east=false,north=true,south=true,waterlogged=false,west=false]' 204; 44; -374; 204; 42; -374;

###########################################################
##                      Катсцены                         ##
###########################################################
parallel '*' [] {
    Shiver.getCameraDuration 'map4_start1' 'wait'
    Entity.spawnItemDisplay 'helicopter' 209.5; 89.5; -389.5; -90; 0; 'e2NvbXBvbmVudHM6eyJtaW5lY3JhZnQ6Y3VzdG9tX21vZGVsX2RhdGEiOntmbG9hdHM6WzEwMDcxLjBmXX19LGNvdW50OjEsaWQ6Im1pbmVjcmFmdDpsZWF0aGVyX2hvcnNlX2FybW9yIn0='
    Entity.displaySetScale 'var(helicopter)' 8; 8; 8;
    Entity.displayRotations 'var(helicopter)' 90; 0; 0; 'set'
    Entity.displaySetOffset 'var(helicopter)' 0; 65; -150;
    Entity.displayInterpolation 'var(helicopter)' 60; 100;
    wait 5
    Entity.displaySetOffset 'var(helicopter)' 0; 65; 150;
    wait var(wait) - 5
    World.sound 'shiver:ambience.map1heli' 16; 1.1; 209.5; 89.5; -389.5;
    Shiver.getCameraDuration 'map4_start2' 'wait'
    wait *wait
    Entity.remove *helicopter
}

runInLine 'maps/common/run_cameras' [[
    'map4_start1';
    'map4_start2';
    'map4_start3'
]]
###########################################################

### Спавн игроков
run 'maps/common/initialize_players' '*' [1; 0; 1]
###

wait 20
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Вертолёт пролетел в сторонну запечатанного тонеля...'
wait var(wait) + 40
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Значит это правда, город выживших существует...'
wait var(wait) + 40
Shiver.showActionbar 'wait' global(LORE_SPEED); 'global(LORE_PREFIX)' 'Но похоже, нам не открыть эти железные двери.'